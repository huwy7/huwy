---
import Serie from './Serie.astro';
import Navigation from './Navigation.astro';
import type { ImageMetadata } from 'astro';
import type { Aufnahmedaten } from '../lib/exif';

// Die Galerie der Startseite in ZWEI Darstellungen, umgeschaltet am einzigen
// Breakpoint der Seite (768px, tokens.css --breakpoint):
//
//   ab 768px (Desktop, iPad)   eine Serie steht gross auf der Bühne, rechts das
//                              Menü mit allen Serientiteln. Gewählt wird dort,
//                              gescrollt wird nicht mehr — die sichtbare Serie
//                              füllt genau eine Bildschirmhöhe.
//   unter 768px (iPhone)       unverändert wie bisher: alle Serien gestapelt,
//                              man scrollt hindurch. Für das Menü ist die Breite
//                              zu knapp.
//
// Die Auswahl läuft über versteckte Radio-Buttons — KEIN JavaScript (CLAUDE.md
// Regel 2). Bewusst Radios und nicht `:target` wie beim Vollbild: das Vollbild
// belegt den Hash bereits, ein Klick darauf würde die Serienauswahl sonst wieder
// aufheben. Radios halten ihren Zustand unabhängig davon, brauchen keinen
// Hash-Sprung und bringen die Tastaturbedienung (Pfeiltasten in der Gruppe) mit.
// Der erste Radio trägt `checked` — damit steht die oberste Serie beim Laden.
interface Props {
  modus?: 'duester' | 'farbe';
  serien: {
    serie: { id: string; data: { titel: string; jahr: number } };
    bilder: { bild: ImageMetadata; daten?: Aufnahmedaten }[];
  }[];
}
const { serien, modus = 'duester' } = Astro.props;

// Welche Serie zu welchem Radio gehört, lässt sich nicht mit EINER statischen
// Regel ausdrücken — jedes Paar braucht seine eigene. Darum hier erzeugt statt
// im <style>-Block. Läuft nur ab dem Breakpoint; darunter greift keine dieser
// Regeln und alle Serien bleiben sichtbar.
// `:has()` am Wurzelelement, weil Radio (im Menü, unten) und Serie (auf der
// Bühne, oben) keine Geschwister sind und `~` daher nicht greift.
const regeln = `@media (min-width: 768px) {
${serien
  .map(
    ({ serie }) => `  .galerie:has(#wahl-${serie.id}:checked) .serie[data-serie="${serie.id}"] { display: flex; }
  .galerie:has(#wahl-${serie.id}:checked) .serien-eintrag[data-fuer="${serie.id}"] { --eintrag-aktiv: 1; }`,
  )
  .join('\n')}
}`;
---

<div class="galerie">
  <div class="serien-buehne">
    {
      serien.map(({ serie, bilder }) => (
        <Serie slug={serie.id} titel={serie.data.titel} jahr={serie.data.jahr} bilder={bilder} />
      ))
    }
  </div>

  {/* Das Menü steht im Markup NACH der Bühne, damit die Tastatur zuerst durchs
      Bild läuft. Optisch sitzt es rechts (order in der CSS-Regel unten). */}
  <nav class="serien-menu" aria-label="Serien">
    {/* Oben im Band: der Modus-Umschalter. Er sieht weiter aus wie in der
        Kopfzeile (gleiche Grösse, gleiche Schrift) und steht auch auf gleicher
        Höhe — nur eben im Band statt darüber. */}
    <div class="menu-kopf">
      <Navigation modus={modus} teil="umschalter" />
    </div>

    <div class="menu-serien">
    {
      serien.map(({ serie }, i) => (
        <label class="serien-eintrag" data-fuer={serie.id}>
          {/* Radio IM Label: so schaltet ein Klick auf den Titel die Serie um und
              `:focus-within` kann den Fokusring am ganzen Eintrag zeigen, obwohl
              das Feld selbst unsichtbar ist. */}
          <input
            type="radio"
            name="serie"
            id={`wahl-${serie.id}`}
            class="serien-wahl"
            checked={i === 0}
          />
          <span class="serien-eintrag-text">{serie.data.titel}</span>
        </label>
      ))
    }
    </div>

    {/* Unten im Band: der Seitenwechsel. Er zeigt immer das ANDERE Ziel — im
        Portfolio steht dort „About me", bei About me steht dort „Portfolio".
        Die Logik dazu steckt in Navigation.astro. */}
    <div class="menu-fuss">
      <Navigation modus={modus} teil="seitenwechsel" />
    </div>
  </nav>
</div>

<style set:html={regeln} is:inline></style>

<style>
  /* --- unter 768px: unverändert wie bisher ---------------------------------
     Kein Menü, keine Auswahl, alle Serien gestapelt. Die Bühne ist nur ein
     Behälter ohne eigenes Layout. */
  .serien-buehne {
    display: flex;
    flex-direction: column;
  }
  .serien-menu {
    display: none;
  }

  /* Das Radio ist nie sichtbar, aber immer fokussierbar — nicht `display: none`,
     sonst fiele es aus der Tastaturreihenfolge und die Serien wären ohne Maus
     nicht mehr wählbar. */
  .serien-wahl {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* --- ab 768px: Bühne links, Menü rechts ---------------------------------- */
  @media (min-width: 768px) {
    .galerie {
      /* Der Höhendeckel der Fotos gilt in dieser Ansicht enger als beim Scrollen
         durch die Serien. Als Token-Überschreibung statt eigener max-height-Regel:
         so zieht alles mit, was schon mit --karussell-hoehe rechnet (das Bild in
         global.css, die Streifenhöhe in Serie.astro). */
      --karussell-hoehe: var(--galerie-foto-hoehe);
      display: flex;
      align-items: stretch;
      /* Ausbruch aus dem zentrierten Seiten-Container (.inhalt, max-width 1280px
         plus --rand). Ohne das säse die Galerie in einem 1280er-Kasten: das Menü
         käme nie an die Fensterkante („rechtes Viertel des Screens" wäre nicht
         wahr) und der Bühne bliebe so wenig Breite, dass die Fotos deutlich
         kleiner ausfielen als auf den Serienseiten — dort deckelt die Höhe
         (--karussell-hoehe, 72vh), hier hätte die Breite gedeckelt.
         `50%` bezieht sich auf den Container, der mittig steht; der Versatz
         schiebt die Galerie also exakt auf Fensterbreite. */
      width: 100vw;
      margin-inline: calc(50% - 50vw);
    }
    .serien-buehne {
      /* `min-width: 0` ist Pflicht: ohne das weigert sich ein Flex-Kind, unter
         die Breite seines Inhalts zu schrumpfen, und das Bild drückte das Menü
         aus dem Fenster. */
      flex: 1;
      min-width: 0;
      /* Der Seitenrand, den die Galerie beim Ausbruch verloren hat — aber nur
         links: rechts schliesst die schwarze Menüfläche bündig ans Fenster an. */
      padding-inline-start: var(--rand);
    }

    /* Nur die gewählte Serie steht auf der Bühne. Sichtbar gemacht wird sie von
       den erzeugten Regeln oben. */
    .serien-buehne :global(.serie) {
      display: none;
    }
    /* Die sichtbare Serie füllt genau eine Bildschirmhöhe — es gibt nichts mehr
       zu scrollen. Serie.astro rechnet den Platz der Kopfzeile sonst nur bei der
       ERSTEN Serie heraus; hier kann jede Serie die erste sein, also gilt die
       Rechnung für alle. */
    .serien-buehne :global(.serie) {
      /* Volle Bildschirmhöhe, NICHT minus Kopfzeile: die ist auf dieser Ansicht
         ausgeblendet (Basis.astro, .kopf--galerie), ihr Platz ist also frei.
         Serie.astro rechnet die Kopfzeile sonst nur bei der ERSTEN Serie heraus;
         hier kann jede Serie die erste sein, also gilt dieselbe Rechnung für alle. */
      min-height: 100svh;
      padding-block-start: 0;
      padding-block-end: 0;
    }

    /* Titel und Jahr zählen hier zum zentrierten Block. Serie.astro rechnet sie
       sonst per negativem Aussenabstand aus der Zentrierung heraus, damit nur der
       Bildstreifen mittig sitzt — der Titel ragt dann nach OBEN heraus und lief
       bei Plakatgrösse unter die Kopfzeile. In dieser Ansicht ist der Platz
       darüber begrenzt und fest (eine Bildschirmhöhe, kein Scrollen), also wird
       der ganze Block zentriert. Der Preis: die Bildmitte liegt nicht mehr exakt
       in der Fensterhöhe, sondern etwas tiefer. */
    .serien-buehne :global(.serie-kopf) {
      margin-block-start: 0;
    }

    /* Das rechte Viertel: eigene schwarze Fläche über die volle Höhe, die
       Einträge darin senkrecht zentriert. */
    .serien-menu {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: var(--menu-abstand);
      width: var(--menu-breite);
      flex: none;
      background-color: var(--menu-grund);
      padding-inline: var(--menu-innenrand);
      /* Drei Zonen im Band: Umschalter oben, Serien mittig, Seitenwechsel unten.
         Die Serienliste bekommt allen Restplatz und zentriert sich darin — so
         stehen die Titel weiter in der Bandmitte, egal wie hoch das Fenster ist. */
      justify-content: flex-start;
      padding-block-end: var(--abstand-32);
      /* Kein Hochzug mehr nötig: die Kopfzeile ist auf dieser Ansicht ausgeblendet
         (Basis.astro, .kopf--galerie), die Galerie beginnt also bereits an der
         Fensterkante. Die Höhe der früheren Kopfzeile steckt jetzt in .menu-kopf —
         dort steht der Umschalter, auf genau der Höhe, auf der die Kopfzeile
         vorher stand. */
    }
    /* Der Umschalter steht auf derselben Höhe wie die Kopfzeile daneben: gleiche
       Bandhöhe (--header-hoehe) und gleicher oberer Innenabstand. Dadurch liest
       sich die Zeile weiter als Kopfzeile, nur eben im Band. */
    .menu-kopf {
      display: flex;
      align-items: baseline;
      min-height: var(--header-hoehe);
      padding-block-start: var(--abstand-32);
      flex: none;
    }
    /* Die Serienliste nimmt den ganzen Rest und zentriert sich darin. */
    .menu-serien {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: var(--menu-abstand);
      min-height: 0;
    }
    .menu-fuss {
      flex: none;
    }
    /* Beide Knöpfe stehen auf der Menüfläche, tragen also deren Schriftfarbe —
       nicht die der Seite. Ohne das wären sie im Farbmodus unsichtbar: dort ist
       die Fläche genau --farbe-text. */
    .menu-kopf :global(.nav-knopf),
    .menu-fuss :global(.nav-knopf) {
      color: var(--menu-text);
    }

    .serien-eintrag {
      /* --eintrag-aktiv wird von den erzeugten Regeln auf 1 gesetzt; darüber
         hängt die Deckkraft, ohne dass eine zweite Klasse nötig wäre. */
      --eintrag-aktiv: 0;
      /* inline-block, NICHT block: der invertierende Cursor-Kasten legt sich um
         das Element. Über die volle Menübreite ergäbe das einen Balken quer
         durch die Fläche; so umschliesst er das Wort — genau wie bei den
         Links in der Kopfzeile. */
      display: inline-block;
      font-family: var(--schrift-beschriftung);
      font-size: var(--menu-groesse);
      line-height: var(--zeilenhoehe-1-2);
      font-variant-ligatures: none;
      color: var(--menu-text);
      /* Die nicht gewählten Titel treten zurück, ohne zu verschwinden. */
      opacity: calc(0.45 + 0.55 * var(--eintrag-aktiv));
      transition: opacity var(--zaehler-tempo) ease;
    }

    /* Fokusring nur bei TASTATUR-Fokus. `:focus-within` griff auch nach einem
       Mausklick — dann blieb ein Rahmen um den gewählten Eintrag stehen.
       `:focus-visible` am Radio überlässt dem Browser die Entscheidung, und
       :has() trägt sie auf den Eintrag, weil das Radio selbst unsichtbar ist. */
    .serien-eintrag:has(.serien-wahl:focus-visible) {
      outline: var(--fokus-breite) solid var(--menu-text);
      outline-offset: var(--fokus-offset);
    }

    /* Ohne JavaScript kein invertierender Cursor — dann übernimmt der Hover die
       Umkehr selbst, wie bei den Textlinks (global.css). Mit aktivem Cursor
       bleibt es aus, sonst invertiert es doppelt. */
    @media (hover: hover) and (pointer: fine) {
      html:not(.cursor-aktiv) .serien-eintrag:hover {
        background-color: var(--menu-text);
        color: var(--menu-grund);
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .serien-eintrag {
      transition: none;
    }
  }
</style>
