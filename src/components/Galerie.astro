---
import Serie from './Serie.astro';
import type { SerieMitBildern } from '../lib/serien';

// Die Bühne der Portfolio-Seiten. Das Menü steckt NICHT mehr hier, sondern im
// Menüband (Menuband.astro), das auf jeder Seite über das Grundgerüst kommt.
//
// Zwei Darstellungen, umgeschaltet am einzigen Breakpoint (768px):
//
//   ab 768px (Desktop, iPad)   nur die Serie aus der Adresse steht auf der
//                              Bühne, in genau einer Bildschirmhöhe. Gewählt
//                              wird im Band rechts, gescrollt wird nicht.
//   unter 768px (iPhone)       unverändert: alle Serien gestapelt, man scrollt
//                              hindurch. Dort gibt es kein Band.
//
// Darum rendert die Seite ALLE Serien, obwohl die Adresse nur eine meint: das
// Smartphone braucht sie alle. Welche auf dem Desktop sichtbar ist, entscheidet
// die Klasse `ist-aktiv` — zur Bauzeit gesetzt, kein JavaScript, keine erzeugten
// CSS-Regeln mehr (das war nötig, solange die Auswahl über Radio-Buttons lief).
interface Props {
  serien: SerieMitBildern[];
  /** Slug der Serie, die auf dem Desktop gezeigt wird. */
  aktiv: string;
}
const { serien, aktiv } = Astro.props;
---

<div class="galerie">
  {
    serien.map((s) => (
      <Serie
        slug={s.slug}
        titel={s.titel}
        jahr={s.jahr}
        bilder={s.bilder}
        class:list={{ 'ist-aktiv': s.slug === aktiv }}
      />
    ))
  }
</div>

<style>
  /* Unter 768px: alle Serien gestapelt, wie bisher. */
  .galerie {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    /* Der Höhendeckel der Fotos gilt in dieser Ansicht enger als beim Scrollen
       durch die Serien: hier stehen Titel, Foto und Zähler gleichzeitig in EINER
       Bildschirmhöhe. Als Token-Überschreibung statt eigener max-height-Regel —
       so zieht alles mit, was schon mit --karussell-hoehe rechnet (das Bild in
       global.css, die Streifenhöhe in Serie.astro). */
    .galerie {
      --karussell-hoehe: var(--galerie-foto-hoehe);
      padding-inline-start: var(--rand);
    }

    /* Nur die Serie aus der Adresse steht auf der Bühne. */
    .galerie :global(.serie) {
      display: none;
    }
    .galerie :global(.serie.ist-aktiv) {
      display: flex;
      /* Volle Bildschirmhöhe, NICHT minus Kopfzeile: die ist ab hier
         ausgeblendet (Basis.astro, .kopf--band), ihr Platz ist frei.
         Serie.astro rechnet die Kopfzeile sonst nur bei der ERSTEN Serie
         heraus; hier kann jede Serie die gezeigte sein. */
      min-height: 100svh;
      padding-block-start: 0;
      padding-block-end: 0;
    }

    /* Titel und Jahr zählen hier zum zentrierten Block. Serie.astro rechnet sie
       sonst per negativem Aussenabstand aus der Zentrierung heraus, damit nur
       der Bildstreifen mittig sitzt — der Titel ragt dann nach OBEN heraus und
       lief bei Plakatgrösse aus dem Bild. In dieser Ansicht ist der Platz
       begrenzt und fest, also wird der ganze Block zentriert. Der Preis: die
       Bildmitte liegt nicht mehr exakt in der Fensterhöhe, sondern etwas tiefer. */
    .galerie :global(.serie-kopf) {
      margin-block-start: 0;
    }
  }
</style>
