---
import Bild from './Bild.astro';
import type { ImageMetadata } from 'astro';

// Eine Serie als inline-Karussell (kein Untermenü): die Bilder liegen nebeneinander
// in einem horizontalen scroll-snap-Streifen; man wischt/blättert direkt auf der
// Hauptseite. Erstes Bild = Titelbild. Klick aufs Bild öffnet die Vollbild-Ansicht,
// die genauso aufgebaut ist — ein Streifen, der seitlich weitergeschoben wird
// (wie ein analoger Film, der durch den Rahmen läuft), kein hartes Umschalten.
//
// Statt Pfeilen zeigt ein Zähler unter dem Bild, wie viele Fotos die Serie hat und
// wo man gerade ist: ein feiner Strich je Bild, der aktive hell. Er ist anklickbar;
// zusätzlich blättern die (unsichtbaren) Flächen links/rechts.
//
// Flaches Bild-Modell: Titel/Jahr/Slug + fertig sortierte Bilder-Liste kommen von
// der Seite (Bilder werden dort aus der bilder-Sammlung nach Serie gruppiert).
interface Props {
  slug: string;
  titel: string;
  jahr: number;
  bilder: ImageMetadata[];
}
const { slug, titel, jahr, bilder } = Astro.props;
const n = bilder.length;

const breiten = [640, 960, 1280, 1600, 2000];
---

<section class="serie" data-serie={slug}>
  <div class="serie-kopf">
    <span class="serie-titel">{titel}</span>
    <span class="serie-jahr">{jahr}</span>
  </div>

  <div class="karussell">
    <ul class="karussell-spur">
      {
        bilder.map((bild, i) => (
          <li id={`k-${slug}-${i}`} class="karussell-bild">
            {/* Bühne schrumpft auf die tatsächliche Bildbreite — so sitzen die
                Blätter-Zonen an den Bildkanten, egal ob Quer- oder Hochformat. */}
            <div class="karussell-buehne">
              <a
                href={`#lb-${slug}`}
                class="karussell-oeffnen"
                data-index={i}
                aria-label="Bild als Vollbild öffnen"
              >
                <Bild
                  class="karussell-foto"
                  src={bild}
                  alt=""
                  widths={breiten}
                  sizes="100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </a>
              {n > 1 && (
                <>
                  {/* Unsichtbare Blätter-Flächen an den Bildkanten. */}
                  <button class="blaettern blaettern-prev" type="button" data-richtung="-1" aria-label="Vorheriges Bild" />
                  <button class="blaettern blaettern-next" type="button" data-richtung="1" aria-label="Nächstes Bild" />
                </>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  {
    n > 1 && (
      <div class="zaehler" role="tablist" aria-label="Bilder der Serie">
        {bilder.map((_, i) => (
          <button class="zaehler-strich" type="button" data-index={i} role="tab" aria-label={`Bild ${i + 1} von ${n}`}>
              <span class="zaehler-linie" />
            </button>
        ))}
      </div>
    )
  }

  {/* Vollbild-Ansicht: EIN Streifen je Serie (nicht eine Ebene je Bild). Dadurch
      schiebt sich beim Blättern das nächste Foto seitlich herein, statt hart
      umzuschalten — dasselbe Verhalten wie im Karussell. */}
  <div id={`lb-${slug}`} class="lightbox">
    <div class="lightbox-spur">
      {
        bilder.map((bild) => (
          <div class="lightbox-ansicht">
            <Bild class="lightbox-bild" src={bild} alt="" widths={breiten} sizes="100vw" loading="lazy" />
            {/* Blätter-Flächen liegen INNERHALB der Ansicht, also im scrollbaren
                Streifen. Nur so wischt der Finger auf ihnen den Streifen weiter —
                lagen sie darüber (Kind der Lightbox), verschluckten sie den Wisch,
                weil ihr Vorfahre nicht der Scroll-Container ist. */}
            {n > 1 && (
              <>
                <button class="lightbox-zone lightbox-prev" type="button" data-richtung="-1" aria-label="Zurück" />
                <button class="lightbox-zone lightbox-next" type="button" data-richtung="1" aria-label="Weiter" />
              </>
            )}
          </div>
        ))
      }
    </div>
    {
      n > 1 && (
        <>
          <div class="zaehler zaehler--lightbox" role="tablist" aria-label="Bilder der Serie">
            {bilder.map((_, i) => (
              <button class="zaehler-strich" type="button" data-index={i} role="tab" aria-label={`Bild ${i + 1} von ${n}`}>
              <span class="zaehler-linie" />
            </button>
            ))}
          </div>
        </>
      )
    }
    <button class="lightbox-x druck-box" type="button" aria-label="Schliessen">×</button>
  </div>
</section>

<script>
  import { starteMobileGalerie } from '../scripts/galerie-mobil';

  // Karussell und Vollbild sind beide horizontale scroll-snap-Streifen. Geblättert
  // wird immer gleich: den Streifen um eine Ansichtsbreite weiterschieben. Dadurch
  // wandert das nächste Foto seitlich herein — auf der Seite wie im Vollbild.
  const reduziert = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const weich = reduziert ? ('auto' as ScrollBehavior) : ('smooth' as ScrollBehavior);

  // Aktuelle Position eines Streifens als Index.
  const index = (spur: HTMLElement) =>
    spur.clientWidth ? Math.round(spur.scrollLeft / spur.clientWidth) : 0;

  const zuIndex = (spur: HTMLElement, i: number, verhalten: ScrollBehavior = weich) => {
    const max = spur.children.length - 1;
    const ziel = Math.min(Math.max(i, 0), max);
    spur.scrollTo({ left: ziel * spur.clientWidth, behavior: verhalten });
  };

  // Hash setzen (steuert :target beim Vollbild), ohne dass die Seite scrollt.
  // WICHTIG: Der Browser führt sein Anker-Scrolling teils erst NACH dem Setzen des
  // Hash aus (eigener Frame) — darum die Position in den nächsten Frames halten.
  const setzeHash = (wert: string) => {
    const y = window.scrollY;
    location.hash = wert;
    const zurueck = () => window.scrollTo(0, y);
    zurueck();
    requestAnimationFrame(() => {
      zurueck();
      requestAnimationFrame(zurueck);
    });
  };

  // Invertierung der Zähler-Striche inline setzen (wie beim Cursor): Graustufen +
  // Umkehr, damit über farbigen Fotos keine bunten Striche entstehen.
  const strichFilter = 'grayscale(1) invert(1)';
  for (const linie of document.querySelectorAll<HTMLElement>('.zaehler-linie')) {
    linie.style.setProperty('backdrop-filter', strichFilter);
    linie.style.setProperty('-webkit-backdrop-filter', strichFilter);
  }

  // Der Streifen ist standardmässig so hoch wie sein höchstes Bild — kürzere Bilder
  // hätten dann unterschiedlich viel Luft nach unten, und der Zähler stünde bei
  // jedem Bild woanders. Darum setzen wir die Höhe auf das gerade sichtbare Bild.
  // Gemessen wird die Bühne, also Bild INKLUSIVE weissem Rahmen: auf der düsteren
  // Seite ist der Rahmen die sichtbare Kante. Ohne JavaScript passiert nichts und
  // die Seite bleibt vollständig bedienbar (nur eben mit der alten Vorgabe-Höhe).
  // Mitten im Blättern sind ZWEI Bilder gleichzeitig zu sehen. Dann gilt die grössere
  // der beiden Höhen, sonst würde das höhere angeschnitten (der Streifen ist vertikal
  // auf `hidden` gestellt, damit man ihn nicht wegschieben kann). Steht der Streifen
  // still, gilt genau die Höhe des sichtbaren Bildes — nur so stimmen die Abstände.
  const passeHoeheAn = (spur: HTMLElement) => {
    const breite = spur.clientWidth;
    if (!breite) return;
    const letzte = spur.children.length - 1;
    // Exakte statt gerundete Höhe: `offsetHeight` rundet auf ganze Pixel, wodurch
    // der Abstand zum Zähler um einen Pixel danebenliegen konnte.
    const hoeheVon = (i: number) =>
      (spur.children[i] as HTMLElement | undefined)
        ?.querySelector<HTMLElement>('.karussell-buehne')
        ?.getBoundingClientRect().height || 0;

    const stelle = spur.scrollLeft / breite;
    const nächste = Math.round(stelle);
    const ruhig = Math.abs(stelle - nächste) < 0.01;
    const hoehe = ruhig
      ? hoeheVon(Math.min(Math.max(nächste, 0), letzte))
      : Math.max(
          hoeheVon(Math.max(Math.floor(stelle), 0)),
          hoeheVon(Math.min(Math.ceil(stelle), letzte)),
        );
    if (!hoehe) return;
    // Wachsen SOFORT, Schrumpfen weich. Läuft das Wachsen über den Übergang, hinkt
    // der Streifen dem Wisch hinterher und schneidet das hereinkommende höhere Bild
    // für einen Moment an (gemessen: 5 von 20 Punkten während eines Wischs).
    // Der Streifen macht also sofort Platz und zieht sich danach ruhig zusammen.
    spur.style.transitionDuration = hoehe > spur.getBoundingClientRect().height ? '0s' : '';
    spur.style.height = `${hoehe}px`;
  };

  for (const serie of document.querySelectorAll<HTMLElement>('.serie')) {
    const slug = serie.dataset.serie || '';
    const karussell = serie.querySelector<HTMLElement>('.karussell-spur');
    const lightbox = serie.querySelector<HTMLElement>('.lightbox');
    const lbSpur = serie.querySelector<HTMLElement>('.lightbox-spur');
    if (!karussell) continue;

    const striche = {
      karussell: serie.querySelectorAll<HTMLElement>('.zaehler:not(.zaehler--lightbox) .zaehler-strich'),
      lightbox: serie.querySelectorAll<HTMLElement>('.zaehler--lightbox .zaehler-strich'),
    };

    const markiere = (liste: NodeListOf<HTMLElement>, i: number) => {
      liste.forEach((s, j) => {
        s.classList.toggle('ist-aktiv', j === i);
        s.setAttribute('aria-selected', j === i ? 'true' : 'false');
      });
    };

    // Zähler und Streifenhöhe folgen dem Streifen. Beides pro Frame höchstens
    // einmal, damit das Scrollen flüssig bleibt.
    let wartet = false;
    karussell.addEventListener(
      'scroll',
      () => {
        markiere(striche.karussell, index(karussell));
        if (wartet) return;
        wartet = true;
        requestAnimationFrame(() => {
          wartet = false;
          passeHoeheAn(karussell);
        });
      },
      { passive: true },
    );
    markiere(striche.karussell, 0);
    // Die Bilder werden aufgeschoben geladen (erst nach dem Entsperren), ihre Höhe
    // steht also nicht von Anfang an fest. Ein ResizeObserver auf den Bühnen deckt
    // alles ab: Nachladen, Drehung, Fensterwechsel — ohne auf load-Ereignisse zu
    // bauen, die bei aufgeschobenen Bildern schon vorbei sein können.
    passeHoeheAn(karussell);
    const beobachter = new ResizeObserver(() => passeHoeheAn(karussell));
    for (const buehne of karussell.querySelectorAll('.karussell-buehne')) {
      beobachter.observe(buehne);
    }
    striche.karussell.forEach((s) =>
      s.addEventListener('click', () => zuIndex(karussell, Number(s.dataset.index))),
    );

    // Blätter-Flächen am Bild.
    for (const knopf of serie.querySelectorAll<HTMLElement>('.blaettern')) {
      knopf.addEventListener('click', () =>
        zuIndex(karussell, index(karussell) + Number(knopf.dataset.richtung)),
      );
    }

    if (!lightbox || !lbSpur) continue;

    // Vollbild öffnen: Hash setzen (macht die Ebene sichtbar), dann den Streifen
    // ohne Animation auf das angeklickte Bild stellen.
    for (const oeffnen of serie.querySelectorAll<HTMLElement>('.karussell-oeffnen')) {
      oeffnen.addEventListener('click', (e) => {
        e.preventDefault();
        const i = Number(oeffnen.dataset.index) || 0;
        setzeHash(`lb-${slug}`);
        requestAnimationFrame(() => {
          zuIndex(lbSpur, i, 'auto');
          markiere(striche.lightbox, i);
        });
      });
    }

    lbSpur.addEventListener('scroll', () => markiere(striche.lightbox, index(lbSpur)), {
      passive: true,
    });
    striche.lightbox.forEach((s) =>
      s.addEventListener('click', () => zuIndex(lbSpur, Number(s.dataset.index))),
    );
    for (const zone of serie.querySelectorAll<HTMLElement>('.lightbox-zone')) {
      zone.addEventListener('click', () =>
        zuIndex(lbSpur, index(lbSpur) + Number(zone.dataset.richtung)),
      );
    }

    // Schliessen: zurück zum selben Bild im Karussell (ohne Sprung).
    const schliessen = () => {
      const i = index(lbSpur);
      zuIndex(karussell, i, 'auto');
      setzeHash(`k-${slug}-${i}`);
    };
    serie.querySelector('.lightbox-x')?.addEventListener('click', schliessen);

    // Tastatur im Vollbild: links/rechts blättern, Escape schliesst.
    addEventListener('keydown', (e) => {
      if (location.hash !== `#lb-${slug}`) return;
      if (e.key === 'ArrowRight') zuIndex(lbSpur, index(lbSpur) + 1);
      else if (e.key === 'ArrowLeft') zuIndex(lbSpur, index(lbSpur) - 1);
      else if (e.key === 'Escape') schliessen();
    });
  }

  // Mobile Galerie: eigene Höhen-, Abstands- und Einrast-Rechnung. Auf dem Desktop
  // passiert hier nichts — das Modul prüft die Bedingung selbst und räumt beim
  // Wechsel alles wieder ab.
  starteMobileGalerie();
</script>

<style>
  /* Eine Bildschirmhöhe pro Serie, Inhalt darin vertikal zentriert — siehe
     .serie-kopf für die Formel, die dabei nur das BILD mittig setzt. */
  .serie {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block-start: var(--header-hoehe);
  }
  /* Bei der ersten Serie steht die Kopfzeile bereits im Fluss darüber. */
  .serie:first-of-type {
    min-height: calc(100vh - var(--header-hoehe));
    min-height: calc(100svh - var(--header-hoehe));
    padding-block-start: 0;
  }
  /* Letzte Serie: Scroll-Reserve für die ein-/ausblendende Browserleiste. */
  .serie:last-of-type {
    padding-block-end: calc(100lvh - 100svh);
  }

  .serie-kopf {
    display: flex;
    gap: var(--abstand-16);
    align-items: baseline;
    font-family: var(--schrift-mono);
    font-size: var(--groesse-14);
    line-height: var(--zeilenhoehe-1-4);
    font-variant-ligatures: none;
    margin-block-end: var(--abstand-24);
    /* Titel und Zähler werden aus der Zentrierung herausgerechnet: ihr Platz wird
       als negativer Aussenabstand wieder abgezogen. Dadurch zentriert die Sektion
       faktisch nur den BILDSTREIFEN im sichtbaren Bereich, nicht den ganzen Block
       mit Titel. Bei Serien aus einem Format liegt damit die Bildmitte exakt in der
       Mitte; bei gemischten Formaten sitzen die kürzeren Bilder etwas höher, weil
       sie oben am Streifen hängen (siehe .karussell-bild). Die Formel arbeitet mit
       den Tokens, passt sich also automatisch an. */
    margin-block-start: calc(
      -1 * (var(--groesse-14) * var(--zeilenhoehe-1-4) + var(--abstand-24))
    );
  }

  /* Inline-Karussell: horizontaler scroll-snap-Streifen, ein Bild pro Ansicht. */
  .karussell {
    position: relative;
  }
  /* Farbseite: der weisse Rand liegt aussen um das Bild (global.css). Damit das
     Bild dabei seine Grösse behält, zieht sich der Streifen um genau die
     Rahmenbreite in den Seitenrand hinein — der Rahmen fällt in diesen Bleed, die
     Bildkante fluchtet weiterhin mit dem Serientitel. --rand ist mit mindestens
     24px immer breiter als der Rahmen, es entsteht also kein Überlauf. */
  :root[data-modus='farbe'] .karussell {
    /* Seitlich: der Rahmen fällt in den Seitenrand, das Bild behält seine Grösse.
       Oben/unten: auf der weissen Seite ist der Rahmen unsichtbar, sichtbare Kante
       ist also das Foto selbst. Der Streifen rückt darum um die Rahmenbreite
       zusammen — dadurch ist der Abstand Titel→Foto und Foto→Zähler hier genauso
       gross wie auf der düsteren Seite der Abstand Titel→weisser Rand und
       weisser Rand→Zähler. Beide Seiten sehen damit gleich aus. */
    margin: calc(-1 * var(--rahmen-breite));
  }
  .karussell-spur {
    list-style: none;
    display: flex;
    /* Die Höhe folgt dem gerade sichtbaren Bild (das Skript setzt sie). Nur so ist
       der Abstand vom Titel zur Bildoberkante und von der Bildunterkante zum Zähler
       bei JEDEM Bild gleich — die Bildhöhe selbst bleibt dabei natürlich dynamisch.
       Ohne JavaScript bleibt es beim Vorgabewert: so hoch wie das höchste Bild der
       Serie (die Seite funktioniert dann unverändert, nur die Abstände wandern). */
    gap: 0;
    transition: height var(--streifen-tempo) cubic-bezier(0.2, 0, 0, 1);
    overflow-x: auto;
    /* Kein overflow-y hier — probiert und verworfen: `overflow-y: hidden` auf dem
       Scroll-Container schluckt den ersten Wisch (getestet, im Karussell wie im
       Vollbild). Der senkrechte Überlauf wird stattdessen an der Quelle vermieden:
       jede Ansicht schneidet ihren eigenen Inhalt ab (.karussell-bild). */
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none; /* Firefox */
    -webkit-overflow-scrolling: touch;
  }
  .karussell-spur::-webkit-scrollbar {
    display: none;
  }
  .karussell-bild {
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    /* Oben ausgerichtet, NICHT zentriert. Enthält eine Serie Quer- UND
       Hochformate, ist der Streifen so hoch wie das höchste Bild; zentriert
       rutschten die kürzeren Bilder nach unten und ihr Abstand zum Serientitel
       wuchs mit (auf dem iPhone gemessen bis 176px statt 40px). Oben ausgerichtet
       ist der Abstand Titel→Bild bei jedem Bild gleich — auf beiden Seiten und auf
       allen Geräten. Der Preis ist bewusst in Kauf genommen: ein kurzes Querformat
       sitzt dadurch etwas über der Mitte des Sichtbereichs, der Freiraum liegt
       unter dem Bild. Entscheidung des Betreibers, nicht ohne Rückfrage ändern. */
    align-items: flex-start;
    justify-content: center;
    /* Die Streifenhöhe folgt dem sichtbaren Bild, höhere Nachbarbilder ragen also
       darüber hinaus. Ohne diese Zeile wäre der Streifen dadurch senkrecht
       scrollbar (`overflow-x: auto` zwingt die andere Achse von `visible` auf
       `auto`) und man konnte das Bild im Karussell nach oben wegschieben. Jede
       Ansicht schneidet darum ihren eigenen Inhalt ab — der Scroll-Container selbst
       bleibt unangetastet, sonst leidet das Wischen. Sichtbar abgeschnitten wird
       nichts: das Skript hält den Streifen beim Blättern auf der Höhe des grösseren
       der beiden gerade sichtbaren Bilder. */
    overflow: hidden;
  }
  .karussell-buehne {
    position: relative;
    max-width: 100%;
    /* KEIN max-height: 100% — die Streifenhöhe richtet sich nach der Bühne, die
       Bühne dürfte sich also nicht umgekehrt nach dem Streifen richten (sonst
       schaukelt sich beides gegenseitig herunter und der Streifen fällt zusammen).
       Die Höhe ist ohnehin durch --karussell-hoehe am Bild selbst gedeckelt. */
  }
  .karussell-oeffnen {
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  /* Unsichtbare Blätter-Flächen an den Bildkanten — kein sichtbarer Pfeil mehr,
     der das Bild stört. Wohin man blättern kann, zeigt der Zähler unten. */
  .blaettern {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 22%;
    z-index: 2;
    padding: 0;
    border: none;
    background: none;
  }
  .blaettern-prev {
    left: 0;
  }
  .blaettern-next {
    right: 0;
  }

  /* Zähler: ein feiner Strich je Bild, der aktive hell. Zeigt Anzahl und Position
     und lädt zum Blättern ein — ohne etwas über das Foto zu legen. */
  /* Feste Gesamtbreite: die Striche teilen sie unter sich auf. Der aktive bekommt
     einen grösseren Anteil und verdrängt die anderen — die bleiben dabei alle
     exakt gleich breit (gleicher Flex-Anteil), egal ob direkter Nachbar oder
     weiter weg. Aussen bleibt die Breite dadurch immer gleich. */
  .zaehler {
    display: flex;
    gap: var(--abstand-8);
    width: var(--zaehler-breite);
    margin-inline: auto;
    margin-block-start: var(--abstand-24);
  }
  /* Knopf = Trefferfläche (unsichtbar) und zugleich der Platzhalter im Raster.
     flex: 1 1 0 → alle inaktiven exakt gleich breit; der aktive wächst. */
  .zaehler-strich {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
    padding: var(--abstand-8) 0;
    border: none;
    background: none;
    transition: flex-grow var(--zaehler-tempo) cubic-bezier(0.2, 0, 0, 1);
  }
  .zaehler-strich.ist-aktiv {
    flex-grow: var(--zaehler-wachstum);
  }
  /* Die Linie hat KEINE eigene Farbe: sie invertiert ihren Untergrund in
     Graustufen (backdrop-filter, per JS inline gesetzt — der CSS-Minifier würde
     den Wert sonst verändern). Dadurch ist sie auf Dunkel wie auf Weiss sichtbar
     und erzeugt über farbigen Fotos keine bunten Ränder. Der aktive Strich
     unterscheidet sich nicht über die Farbe, sondern weil er länger und dicker
     ist — beim Blättern wächst der neue und der alte schrumpft. */
  .zaehler-linie {
    display: block;
    width: 100%;
    height: var(--strich-staerke);
    transition: height var(--zaehler-tempo) cubic-bezier(0.2, 0, 0, 1);
  }
  .ist-aktiv .zaehler-linie {
    height: var(--strich-staerke-aktiv);
  }
  /* Ohne backdrop-filter (alte Browser) bleibt der Strich sichtbar: dann als
     einfache Fläche in der Textfarbe. */
  @supports not (backdrop-filter: invert(1)) {
    .zaehler-linie {
      background-color: var(--farbe-text);
      opacity: 0.5;
    }
    .ist-aktiv .zaehler-linie {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .zaehler-strich,
    .zaehler-linie,
    .karussell-spur {
      transition: none;
    }
  }

  /* Hand-Zeiger nur, solange NICHT unser eigener Cursor läuft. Sonst zeigte
     Chrome über diesen Flächen zusätzlich den System-Zeiger: Astro hängt an
     Scoped-Styles ein Attribut an den Selektor, dadurch schlugen sie die globale
     Regel `html.cursor-aktiv * { cursor: none }`. */
  html:not(.cursor-aktiv) .blaettern,
  html:not(.cursor-aktiv) .zaehler-strich,
  html:not(.cursor-aktiv) .lightbox-zone,
  html:not(.cursor-aktiv) .lightbox-x {
    cursor: pointer;
  }

  /* --- Vollbild-Ansicht --- weisse Fläche, Bilder als Streifen. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-lightbox);
    display: none;
    background-color: var(--farbe-rahmen);
  }
  .lightbox:target {
    display: block;
  }
  .lightbox-spur {
    display: flex;
    height: 100%;
    overflow-x: auto;
    /* KEIN overflow-y: hidden hier — probiert und wieder entfernt: es nimmt dem
       Vollbild das Wischen (getestet, Wisch blätterte nicht mehr). Nötig ist es
       hier ohnehin nicht: die Bilder passen immer in die Höhe (gemessen: Inhalt =
       Streifenhöhe), es gibt also nichts wegzuschieben. Im Karussell ist der Fall
       anders — dort folgt die Höhe dem Bild und `hidden` ist Pflicht. */
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .lightbox-spur::-webkit-scrollbar {
    display: none;
  }
  .lightbox-ansicht {
    position: relative; /* Bezugsrahmen der Blätter-Flächen */
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Halbe Flächen zum Blättern (unsichtbar). Die weisse Fläche schliesst NICHT —
     Schliessen nur über das ✕. */
  .lightbox-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 1;
    padding: 0;
    border: none;
    background: none;
  }
  .lightbox-prev {
    left: 0;
  }
  .lightbox-next {
    right: 0;
  }

  /* Zähler im Vollbild: unten mittig, dunkel auf der weissen Fläche. */
  .zaehler--lightbox {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--abstand-16);
    z-index: 3;
    margin-block-start: 0;
  }

  /* Kreuz oben rechts über allem, mit grosser Trefferfläche. */
  /* ------------------------------------------------------------------------
     NUR MOBIL. Alles darüber ist die Desktop-Fassung und bleibt unverändert;
     dieser Block überschreibt sie ausschliesslich auf mobilen Geräten. Die
     Bedingung steht wörtlich genauso in `galerie-mobil.ts` und `global.css` —
     CSS kann sie nicht aus einem Token lesen, darum die Wiederholung.

     Aufteilung: die festen Abstände (Titel↔Bild↔Zähler, Rahmen) stehen hier im
     CSS, alle von der Viewportgrösse abhängigen Masse rechnet `galerie-mobil.ts`
     und setzt sie als Inline-Werte bzw. als `--bild-deckel`.

     Die Kennzeichnung sitzt als Klasse `ist-mobil` auf der SERIE selbst, nicht auf
     der Wurzel: Astro hängt sein Scope-Attribut an jeden Teil eines Selektors, und
     eine Klasse auf `<html>` trägt dieses Attribut nicht — solche Regeln greifen
     dann nie (nachgeprüft am gebauten CSS).
     ------------------------------------------------------------------------ */
  @media (hover: none) and (pointer: coarse) and (max-width: 500px) and (orientation: portrait) {
    /* Die Desktop-Zentrierung (eine Bildschirmhöhe je Serie, Titel aus der
       Zentrierung herausgerechnet) wird abgeschaltet. Mobil bekommt jede Serie
       eine gemessene Höhe und rastet als Ganzes mittig ein. */
    .serie.ist-mobil {
      padding-block-start: 0;
    }
    .serie.ist-mobil:last-of-type {
      padding-block-end: 0;
    }
    .ist-mobil .serie-kopf {
      margin-block-start: 0;
    }

    /* Querformat nutzt die volle Breite: seitlich bleibt genau eine Rahmenbreite
       bis zum Displayrand. Der Streifen greift dafür über den Seitenrand hinaus.
       Was „bis zum Displayrand" heisst, richtet sich wie überall nach der
       SICHTBAREN Kante — düster der weisse Rahmen, farbig das Foto. */
    .ist-mobil .karussell {
      margin-inline: calc(var(--rahmen-breite) - var(--rand));
    }
    :root[data-modus='farbe'] .ist-mobil .karussell {
      margin-inline: calc(-1 * var(--rand));
    }
  }

  .lightbox-x {
    position: absolute;
    top: var(--abstand-8);
    right: var(--abstand-8);
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--abstand-48);
    height: var(--abstand-48);
    padding: 0;
    border: none;
    background: none;
    font-family: var(--schrift-mono);
    font-size: var(--groesse-28);
    line-height: 1;
    color: var(--farbe-hintergrund);
  }
</style>
