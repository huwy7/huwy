---
import Bild from './Bild.astro';
import type { CollectionEntry } from 'astro:content';

// Eine Serie als inline-Karussell (kein Untermenü): die Bilder liegen nebeneinander
// in einem horizontalen scroll-snap-Streifen; man wischt/blättert direkt auf der
// Hauptseite. Titelbild = erstes Bild. Klick aufs Bild öffnet die Vollbild-Ansicht
// (Lightbox) mit Blättern links/rechts (endlos) und ✕ zum Schliessen. Alles reines
// CSS (:target + scroll-snap), kein JavaScript.
interface Props {
  serie: CollectionEntry<'serien'> | CollectionEntry<'farbserien'>;
}
const { serie } = Astro.props;
const slug = serie.id;
const bilder = [serie.data.titelbild, ...serie.data.bilder];
const n = bilder.length;
const nachbar = (i: number, d: number) => (i + d + n) % n; // mit Loop

const breiten = [640, 960, 1280, 1600, 2000];
---

<section class="serie">
  <div class="serie-kopf">
    <span class="serie-titel">{serie.data.titel}</span>
    <span class="serie-jahr">{serie.data.jahr}</span>
  </div>

  <div class="karussell">
    <ul class="karussell-spur">
      {
        bilder.map((bild, i) => (
          <li id={`k-${slug}-${i}`} class="karussell-bild">
            <a
              href={`#lb-${slug}-${i}`}
              class="karussell-oeffnen"
              aria-label="Bild als Vollbild öffnen"
            >
              <Bild
                class="karussell-foto"
                src={bild}
                alt=""
                widths={breiten}
                sizes="100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </a>
            {n > 1 && (
              <>
                <a
                  class="karussell-pfeil karussell-prev"
                  href={`#k-${slug}-${nachbar(i, -1)}`}
                  aria-label="Vorheriges Bild"
                >
                  ‹
                </a>
                <a
                  class="karussell-pfeil karussell-next"
                  href={`#k-${slug}-${nachbar(i, 1)}`}
                  aria-label="Nächstes Bild"
                >
                  ›
                </a>
              </>
            )}
          </li>
        ))
      }
    </ul>
  </div>

  {/* Vollbild-Ansichten (reines CSS via :target). Links/rechts blättern (endlos),
      ✕ schliesst und bringt zurück zum Bild im Karussell. */}
  {
    bilder.map((bild, i) => (
      <div id={`lb-${slug}-${i}`} class="lightbox">
        <a
          class="lightbox-zone lightbox-prev"
          href={`#lb-${slug}-${nachbar(i, -1)}`}
          aria-label="Zurück"
        />
        <a
          class="lightbox-zone lightbox-next"
          href={`#lb-${slug}-${nachbar(i, 1)}`}
          aria-label="Weiter"
        />
        <Bild class="lightbox-bild" src={bild} alt="" widths={breiten} sizes="100vw" loading="lazy" />
        <a class="lightbox-x" href={`#k-${slug}-${i}`} aria-label="Schliessen">
          ×
        </a>
      </div>
    ))
  }
</section>

<style>
  .serie-kopf {
    display: flex;
    gap: var(--abstand-16);
    align-items: baseline;
    font-family: var(--schrift-mono);
    font-size: var(--groesse-14);
    line-height: var(--zeilenhoehe-1-4);
    font-variant-ligatures: none;
    margin-block-end: var(--abstand-24);
  }
  .serie-jahr {
    color: var(--farbe-text-leise);
  }

  /* Inline-Karussell: horizontaler scroll-snap-Streifen, ein Bild pro Ansicht. */
  .karussell {
    position: relative;
  }
  .karussell-spur {
    list-style: none;
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none; /* Firefox */
    -webkit-overflow-scrolling: touch;
  }
  .karussell-spur::-webkit-scrollbar {
    display: none;
  }
  .karussell-bild {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--karussell-hoehe);
  }
  .karussell-oeffnen {
    display: block;
    line-height: 0;
    text-decoration: none;
    max-width: 100%;
    max-height: 100%;
  }

  /* Blätter-Pfeile an den Bildrändern (nur bei mehr als einem Bild). Reines CSS:
     sie zeigen auf das Nachbar-Bild im Streifen (Anker), der Streifen scrollt hin. */
  .karussell-pfeil {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 18%;
    display: flex;
    align-items: center;
    z-index: 2;
    font-family: var(--schrift-mono);
    font-size: var(--groesse-22);
    color: var(--farbe-text);
    text-decoration: none;
    opacity: 0.55;
    padding-inline: var(--abstand-16);
  }
  .karussell-prev {
    left: 0;
    justify-content: flex-start;
  }
  .karussell-next {
    right: 0;
    justify-content: flex-end;
  }
  @media (hover: hover) and (pointer: fine) {
    .karussell-pfeil:hover {
      opacity: 1;
    }
  }

  /* --- Vollbild-Ansicht (Lightbox) --- weiss, Bild zentriert. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-lightbox);
    display: none;
    background-color: var(--farbe-rahmen);
  }
  .lightbox:target {
    display: block;
  }
  /* Halbe Flächen zum Blättern: links zurück, rechts weiter. Die weisse Fläche
     schliesst NICHT (Schliessen nur über ✕). */
  .lightbox-zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 1;
  }
  .lightbox-prev {
    left: 0;
    cursor: w-resize;
  }
  .lightbox-next {
    right: 0;
    cursor: e-resize;
  }
  /* Kreuz oben rechts über allem. */
  .lightbox-x {
    position: absolute;
    top: var(--abstand-24);
    right: var(--abstand-24);
    z-index: 3;
    font-family: var(--schrift-mono);
    font-size: var(--groesse-22);
    line-height: 1;
    color: var(--farbe-hintergrund);
    text-decoration: none;
    cursor: pointer;
  }
</style>
