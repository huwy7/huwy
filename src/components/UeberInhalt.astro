---
import Bild from './Bild.astro';
import type { ImageMetadata } from 'astro';

// Inhalt der About-Seiten. Text kommt als Slot (gerendertes Markdown aus dem CMS),
// die Bilder als flexible Liste (abwechselnd rechts/links, Format dynamisch =
// echtes Seitenverhältnis, Grösse passend zur Seite — nicht seitenfüllend).
// spotify: nur die düstere Seite bekommt zusätzlich den Spotify-API-Platzhalter.
interface Props {
  bilder: ImageMetadata[];
  spotify?: boolean;
}
const { bilder, spotify = false } = Astro.props;
const breiten = [640, 960, 1280];
---

<div class="ueber">
  <div class="ueber-text fliesstext">
    <slot />
  </div>

  {
    bilder.length > 0 && (
      <div class="ueber-galerie">
        {bilder.map((bild, i) => (
          <div class:list={['ueber-bild', i % 2 === 0 ? 'ueber-bild--rechts' : 'ueber-bild--links']}>
            <Bild
              class="ueber-foto"
              src={bild}
              alt=""
              widths={breiten}
              sizes="(max-width: 768px) 100vw, 640px"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    )
  }

  {
    spotify && (
      <section class="spotify" aria-label="Spotify — Platzhalter">
        <div class="spotify-cover" aria-hidden="true" />
        <div class="spotify-info">
          <span class="spotify-label">Spotify — Platzhalter (API folgt)</span>
          <span class="spotify-bar spotify-bar--titel" aria-hidden="true" />
          <span class="spotify-bar spotify-bar--kuenstler" aria-hidden="true" />
        </div>
      </section>
    )
  }
</div>

<style>
  .ueber-text {
    font-size: var(--groesse-16);
    line-height: var(--zeilenhoehe-1-6);
  }
  .ueber-text :global(p + p) {
    margin-block-start: var(--abstand-16);
  }

  /* Bilder abwechselnd rechts/links, mit vertikalem Rhythmus. Die Grösse steckt in
     .ueber-foto (global, weil das <img> aus der Bild-Komponente kommt). */
  .ueber-galerie {
    display: flex;
    flex-direction: column;
    gap: var(--rhythmus-block);
    margin-block-start: var(--rhythmus-block);
  }
  .ueber-bild {
    display: flex;
  }
  .ueber-bild--rechts {
    justify-content: flex-end;
  }
  .ueber-bild--links {
    justify-content: flex-start;
  }
  @media (max-width: 768px) {
    /* Mobil: volle Breite, Ausrichtung egal. */
    .ueber-bild {
      justify-content: center;
    }
  }

  /* Spotify-Platzhalter (nur düster): angedeutete „Now playing"-Karte. */
  .spotify {
    display: flex;
    align-items: center;
    gap: var(--abstand-16);
    padding: var(--abstand-16);
    border: var(--linie-staerke) solid var(--farbe-linie);
    max-width: 420px;
    margin-block-start: var(--rhythmus-block);
  }
  .spotify-cover {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    background-color: var(--farbe-platzhalter);
  }
  .spotify-info {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-8);
    width: 100%;
  }
  .spotify-label {
    font-family: var(--schrift-mono);
    font-size: var(--groesse-12);
    color: var(--farbe-text-leise);
    font-variant-ligatures: none;
  }
  .spotify-bar {
    height: 10px;
    background-color: var(--farbe-platzhalter);
  }
  .spotify-bar--titel {
    width: 70%;
  }
  .spotify-bar--kuenstler {
    width: 45%;
  }
</style>
