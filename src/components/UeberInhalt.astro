---
import Bild from './Bild.astro';
import type { ImageMetadata } from 'astro';

// Inhalt der About-Seiten. Jedes Bild steht in einer eigenen Reihe zusammen mit
// seinem (optionalen) Text daneben; die Reihen wechseln sich ab: erstes Bild
// rechts / Text links, zweites Bild links / Text rechts, usw. Ohne Text bleibt
// die Textseite einfach leer. Format der Bilder dynamisch (echtes Seitenverhältnis).
// spotify: nur die düstere Seite bekommt zusätzlich den Spotify-API-Platzhalter.
interface Props {
  eintraege: { bild: ImageMetadata; text?: string }[];
  spotify?: boolean;
}
const { eintraege, spotify = false } = Astro.props;
const breiten = [640, 960, 1280];
---

<div class="ueber">
  {
    eintraege.length > 0 && (
      <div class="ueber-galerie">
        {eintraege.map((e, i) => (
          <div class:list={['ueber-reihe', i % 2 === 0 ? 'foto-rechts' : 'foto-links']}>
            <div class="ueber-text-zelle fliesstext">
              {e.text &&
                e.text
                  .split(/\n{2,}/)
                  .map((absatz) => <p>{absatz}</p>)}
            </div>
            <div class="ueber-foto-zelle">
              <Bild
                class="ueber-foto"
                src={e.bild}
                alt=""
                widths={breiten}
                sizes="(max-width: 768px) 100vw, 45vw"
                loading="lazy"
              />
            </div>
          </div>
        ))}
      </div>
    )
  }

  {
    spotify && (
      <section class="spotify" aria-label="Spotify — Platzhalter">
        <div class="spotify-cover" aria-hidden="true" />
        <div class="spotify-info">
          <span class="spotify-label">Spotify — Platzhalter (API folgt)</span>
          <span class="spotify-bar spotify-bar--titel" aria-hidden="true" />
          <span class="spotify-bar spotify-bar--kuenstler" aria-hidden="true" />
        </div>
      </section>
    )
  }
</div>

<style>
  /* Jede Reihe: Text und Bild nebeneinander, abwechselnd links/rechts. */
  .ueber-galerie {
    display: flex;
    flex-direction: column;
    gap: var(--rhythmus-block);
    margin-block-start: var(--rhythmus-block);
  }
  .ueber-reihe {
    display: flex;
    gap: var(--abstand-32);
    align-items: center;
  }
  /* foto-rechts: Text links, Bild rechts (DOM-Reihenfolge Text→Bild).
     foto-links: umgekehrt via row-reverse. */
  .foto-links {
    flex-direction: row-reverse;
  }
  .ueber-text-zelle {
    flex: 1 1 0;
    min-width: 0;
    font-size: var(--groesse-16);
    line-height: var(--zeilenhoehe-1-6);
  }
  .ueber-text-zelle :global(p + p) {
    margin-block-start: var(--abstand-16);
  }
  .ueber-foto-zelle {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
  }
  .foto-rechts .ueber-foto-zelle {
    justify-content: flex-end;
  }
  .foto-links .ueber-foto-zelle {
    justify-content: flex-start;
  }
  @media (max-width: 768px) {
    /* Mobil: gestapelt, Bild zuerst, Text darunter — beide volle Breite. */
    .ueber-reihe,
    .ueber-reihe.foto-links {
      flex-direction: column;
      align-items: stretch;
      gap: var(--abstand-24);
    }
    .ueber-foto-zelle {
      order: -1;
      justify-content: center;
    }
  }

  /* Spotify-Platzhalter (nur düster): angedeutete „Now playing"-Karte. */
  .spotify {
    display: flex;
    align-items: center;
    gap: var(--abstand-16);
    padding: var(--abstand-16);
    border: var(--linie-staerke) solid var(--farbe-linie);
    max-width: 420px;
    margin-block-start: var(--rhythmus-block);
  }
  .spotify-cover {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    background-color: var(--farbe-platzhalter);
  }
  .spotify-info {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-8);
    width: 100%;
  }
  .spotify-label {
    font-family: var(--schrift-mono);
    font-size: var(--groesse-12);
    color: var(--farbe-text-leise);
    font-variant-ligatures: none;
  }
  .spotify-bar {
    height: 10px;
    background-color: var(--farbe-platzhalter);
  }
  .spotify-bar--titel {
    width: 70%;
  }
  .spotify-bar--kuenstler {
    width: 45%;
  }
</style>
