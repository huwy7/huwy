---
import '../styles/tokens.css';
import '../styles/schriften.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import torBild from '../assets/tor.jpeg';
import farbeBild from '../assets/farbe-hintergrund.jpeg';

interface Props {
  titel: string;
  beschreibung?: string;
  // Pfad zum Open-Graph-Bild (z. B. aus getImage), wird absolut aufgelöst.
  ogBild?: string;
  // Modus: 'duester' (Standard, Schwarzweiss) oder 'farbe' (farbige Unterseite).
  // Steuert Theme (data-modus), Kopfzeilen-Layout (gespiegelt) und Ziele.
  modus?: 'duester' | 'farbe';
}

const { titel, beschreibung, ogBild, modus = 'duester' } = Astro.props;

// Modus-abhängige Navigation. Farbmodus ist gespiegelt (Menü rechts, Umschalt-
// Button links); Beschriftungen englisch, nur der Umschalt-Button spanisch.
const farbe = modus === 'farbe';
const portfolioZiel = farbe ? '/color' : '/';
const aboutZiel = farbe ? '/color/ueber-mich' : '/ueber-mich';
const aboutLabel = farbe ? 'More about me' : 'About me';
const switchZiel = farbe ? '/' : '/color';
// Spanisch, augenzwinkernd — als Einladung/Frage. Nur diese Buttons sind spanisch.
const switchLabel = farbe ? 'A mí me gusta la noche' : '¿A quién le gusta el sol?';

// Hintergrund des Zugangs-Tors: das raue Schwarzweiss-Foto (grain, düster —
// CLAUDE.md 1a) füllt den Bildschirm formatunabhängig (cover). Optimiert über
// astro:assets zu AVIF/WebP; per image-set wählt der Browser das kleinste Format.
const torAvif = await getImage({ src: torBild, format: 'avif', quality: 62 });
const torWebp = await getImage({ src: torBild, format: 'webp', quality: 80 });
const torHintergrund = `image-set(url("${torAvif.src}") type("image/avif"), url("${torWebp.src}") type("image/webp"))`;

// Verwischter Seitenhintergrund im Farbmodus: ein warmes Sonnenuntergangs-Foto,
// analog zum düsteren Blur-Hund. Wird nur verwischt gezeigt (global.css) — darum
// klein gerendert (Download minimal). Grundton warm, keine Graustufen. Nur im
// Farbmodus geladen; der Sperrbildschirm (#tor) behält überall den Hund.
const farbeAvif = await getImage({ src: farbeBild, width: 1280, format: 'avif', quality: 58 });
const farbeWebp = await getImage({ src: farbeBild, width: 1280, format: 'webp', quality: 72 });
const farbeHintergrund = `image-set(url("${farbeAvif.src}") type("image/avif"), url("${farbeWebp.src}") type("image/webp"))`;

// --tor-bg trägt den Sperrbildschirm-Hund (beide Modi). Im Farbmodus zusätzlich
// --farbe-bg für den verwischten Sonnenuntergang; nur dort wird die Datei geladen.
const bodyStil = farbe
  ? `--tor-bg: ${torHintergrund}; --farbe-bg: ${farbeHintergrund}`
  : `--tor-bg: ${torHintergrund}`;

// Aktive Navigation: Portfolio umfasst Startseite und Serienseiten (die Galerie),
// About me die gleichnamige Seite — je Modus mit eigenem Pfad-Präfix.
const pfad = Astro.url.pathname;
const istPortfolio = farbe
  ? pfad === '/color' || pfad.startsWith('/color/serien')
  : pfad === '/' || pfad.startsWith('/serien');
const istUeber = farbe ? pfad.startsWith('/color/ueber-mich') : pfad.startsWith('/ueber-mich');

// Absolute URLs für Kanonik und Open Graph.
const kanonisch = new URL(Astro.url.pathname, Astro.site);
const ogBildAbsolut = ogBild ? new URL(ogBild, Astro.site) : undefined;

// Nur für Meta (og:site_name), nicht sichtbar. TODO_NAME bleibt Platzhalter.
const name = 'TODO_NAME';
---

<!doctype html>
<html lang="de" data-modus={modus}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{titel}</title>
    {beschreibung && <meta name="description" content={beschreibung} />}
    <link rel="canonical" href={kanonisch} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={titel} />
    {beschreibung && <meta property="og:description" content={beschreibung} />}
    <meta property="og:url" content={kanonisch} />
    {ogBildAbsolut && <meta property="og:image" content={ogBildAbsolut} />}
    <meta name="twitter:card" content={ogBildAbsolut ? 'summary_large_image' : 'summary'} />

    <script is:inline>
      // Zugangs-Tor: in dieser Sitzung schon freigeschaltet? Dann sofort ausblenden
      // (kein Aufblitzen). sessionStorage statt localStorage — die Freischaltung gilt
      // nur für den aktuellen Besuch (Tab/Sitzung). Bei jedem neuen Aufruf der Seite
      // wird der Code wieder verlangt.
      try {
        if (sessionStorage.getItem('tor') === 'auf') document.documentElement.dataset.tor = 'auf';
      } catch (e) {}
    </script>
  </head>
  <body style={bodyStil}>
    <!-- Zugangs-Tor (Platzhalter). ACHTUNG: kein echter Schutz auf einer statischen
         Seite — nur eine sichtbare Sperre gegen zufällige Besucher. Siehe docs.
         --tor-bg steht auf <body>, damit auch der verwischte Seitenhintergrund
         (global.css body::before) dieselbe Bilddatei nutzt. -->
    <div id="tor">
      <form id="tor-form" autocomplete="off">
        <input id="tor-code" type="password" autocomplete="off" aria-label="Zugangscode" />
      </form>
    </div>

    <!-- Kopfzeile: Portfolio + About me, dazu der Modus-Umschalt-Button. Gespiegelt
         je Modus (düster: Menü links / Button rechts; farbig: Button links / Menü
         rechts). Schlicht, mono, Fokus bleibt auf den Bildern. -->
    <header class="kopf">
      {
        farbe ? (
          <>
            <a class="kopf-switch" href={switchZiel}>
              {switchLabel}
            </a>
            <nav class="kopf-nav" aria-label="Hauptnavigation">
              <a href={aboutZiel} aria-current={istUeber ? 'page' : undefined}>
                {aboutLabel}
              </a>
              <a href={portfolioZiel} aria-current={istPortfolio ? 'page' : undefined}>
                Portfolio
              </a>
            </nav>
          </>
        ) : (
          <>
            <nav class="kopf-nav" aria-label="Hauptnavigation">
              <a href={portfolioZiel} aria-current={istPortfolio ? 'page' : undefined}>
                Portfolio
              </a>
              <a href={aboutZiel} aria-current={istUeber ? 'page' : undefined}>
                {aboutLabel}
              </a>
            </nav>
            <a class="kopf-switch" href={switchZiel}>
              {switchLabel}
            </a>
          </>
        )
      }
    </header>

    <main class="inhalt">
      <slot />
    </main>

    <style>
      /* Kopfzeile: gleicher Rasterrahmen wie der Inhalt, schlicht und mono. Menü und
         Umschalt-Button sitzen an den beiden Enden (space-between) — dadurch ist die
         Kopfzeile im Farbmodus automatisch gespiegelt (dort steht der Button zuerst
         im Markup, also links, das Menü rechts). */
      .kopf {
        display: flex;
        flex-wrap: wrap; /* langer spanischer Button rutscht bei Bedarf in eine 2. Zeile */
        justify-content: space-between;
        align-items: center;
        gap: var(--abstand-8) var(--abstand-24);
        max-width: var(--container);
        width: 100%;
        margin-inline: auto;
        padding-inline: var(--rand);
        padding-block: var(--abstand-24);
      }

      .kopf-nav {
        display: flex;
        gap: var(--abstand-24);
      }

      /* Beschriftungen brechen nicht mitten im Wort/Satz um; lieber die ganze
         Gruppe in eine neue Zeile (via flex-wrap oben). */
      .kopf-nav a,
      .kopf-switch {
        white-space: nowrap;
      }

      .kopf-nav,
      .kopf-switch {
        font-family: var(--schrift-mono);
        font-size: var(--groesse-14);
        line-height: var(--zeilenhoehe-1-4);
        font-variant-ligatures: none;
      }

      .kopf-nav a,
      .kopf-switch {
        color: var(--farbe-text-leise);
        text-decoration: none;
      }

      /* Aktive Seite hervorheben (die andere bleibt gedämpft). */
      .kopf-nav a[aria-current='page'] {
        color: var(--farbe-text);
      }

      /* Umschalt-Button (spanisch) — etwas präsenter als die Navigation. */
      .kopf-switch {
        color: var(--farbe-text);
      }

      .inhalt {
        flex: 1 0 auto;
        max-width: var(--container);
        width: 100%;
        margin-inline: auto;
        padding-inline: var(--rand);
        padding-block: var(--abstand-64);
      }

      /* Zugangs-Tor: das raue Schwarzweiss-Foto füllt den Bildschirm (cover),
         formatunabhängig zentriert. Darüber ein weicher, mittiger Dunkel-Schleier,
         damit das Eingabefeld auch über hellen Bildpartien (Zähne) lesbar bleibt —
         der Rand des Fotos bleibt kräftig. Fällt image-set aus, greift die
         near-black Grundfarbe. */
      #tor {
        position: fixed;
        inset: 0;
        z-index: var(--z-tor);
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--farbe-hintergrund);
        background-image:
          radial-gradient(
            ellipse at center,
            rgba(0, 0, 0, 0.62) 0%,
            rgba(0, 0, 0, 0.2) 45%,
            rgba(0, 0, 0, 0) 72%
          ),
          var(--tor-bg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }
      /* Hochkant: der zentrierte Ausschnitt zeigt v. a. Auge/Wange, die Zähne nur
         am Rand. Das Bild etwas nach rechts Richtung Schnauze schieben, damit mehr
         vom Hundegebiss sichtbar ist. Nur Position — keine Bildbearbeitung. Nur
         Hochformat; Querformat bleibt zentriert. Der Dunkel-Schleier (erste Ebene)
         bleibt mittig hinter dem Eingabefeld, nur das Foto (zweite Ebene) wandert. */
      @media (orientation: portrait) {
        #tor {
          background-position: center, 72% center;
        }
      }
      html[data-tor='auf'] #tor {
        display: none;
      }
      /* Eingabefeld als Box mit Invert-Effekt: weisse Fläche + mix-blend-mode:
         difference wirkt wie eine transparente, invertierte Box (dasselbe Prinzip
         wie der Cursor). Der Untergrund (Foto) erscheint im Kasten invertiert;
         Text und Cursor in near-black kontrastieren dadurch immer. Harte Kante,
         kein Rahmen nötig — die invertierte Fläche ist die Box. */
      #tor-code {
        width: 14ch;
        padding: var(--abstand-8) var(--abstand-16);
        font-family: var(--schrift-mono);
        font-size: var(--groesse-16);
        color: var(--farbe-hintergrund);
        text-align: center;
        background: var(--farbe-rahmen);
        mix-blend-mode: difference;
        border: none;
        border-radius: 0;
        outline: none;
        caret-color: var(--farbe-hintergrund);
        font-variant-ligatures: none;
      }
      /* Der Touch-Schweif (.spur / .spur__punkt) steht in global.css — die
         Punkte werden per JS erzeugt und tragen kein Astro-Scope-Attribut. */
    </style>

    <script>
      // Zugangs-Tor (Platzhalter). WICHTIG: Auf einer statischen Seite ist das
      // KEIN echter Schutz — Fotos bleiben unter ihren URLs öffentlich abrufbar.
      // Nur eine sichtbare Sperre gegen zufällige Besucher. Code als SHA-256-Hash.
      const TOR_HASH = 'db6b24692506611e2549894ab528b028af27e114f74fabf2fcb2b0e740fe5a04';
      const tor = document.getElementById('tor');
      const torForm = document.getElementById('tor-form');
      const torCode = document.getElementById('tor-code') as HTMLInputElement | null;

      const sha256 = async (text: string) => {
        const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
        return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
      };

      if (document.documentElement.dataset.tor !== 'auf') torCode?.focus();

      torForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!torCode) return;
        if ((await sha256(torCode.value)) === TOR_HASH) {
          try {
            // Nur für den aktuellen Besuch merken (sessionStorage) — beim nächsten
            // Aufruf der Seite ist der Code erneut nötig. Erlaubt aber das Navigieren
            // zwischen Start- und Serienseiten innerhalb desselben Besuchs.
            sessionStorage.setItem('tor', 'auf');
          } catch (err) {}
          document.documentElement.dataset.tor = 'auf';
        } else {
          torCode.value = '';
          tor?.classList.add('tor--falsch');
          setTimeout(() => tor?.classList.remove('tor--falsch'), 400);
        }
      });
    </script>

    <script>
      // Invertierter Cursor — Progressive Enhancement (CLAUDE.md 4a).
      const feinerZeiger = window.matchMedia('(pointer: fine)');
      if (feinerZeiger.matches) {
        const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)');
        const wurzel = document.documentElement;

        const cursor = document.createElement('div');
        cursor.className = 'cursor';
        cursor.setAttribute('aria-hidden', 'true');
        const punkt = document.createElement('span');
        punkt.className = 'cursor__punkt';
        // Transparent invertierend statt gefüllt — der Kreis kehrt den Untergrund
        // um (inkl. Text) und bleibt überall sichtbar. Inline gesetzt, da der
        // CSS-Minifier backdrop-filter/invert(1) verändern würde.
        punkt.style.setProperty('backdrop-filter', 'invert(1)');
        punkt.style.setProperty('-webkit-backdrop-filter', 'invert(1)');
        cursor.appendChild(punkt);
        document.body.appendChild(cursor);
        wurzel.classList.add('cursor-aktiv');

        let zielX = window.innerWidth / 2;
        let zielY = window.innerHeight / 2;
        let istX = zielX;
        let istY = zielY;
        let mausX = zielX; // letzte Zeigerposition (Freimodus)
        let mausY = zielY;
        let sichtbar = false;
        let boxEl: Element | null = null; // aktuell umschlossenes Element (Box-Modus)
        const BOX_PAD = 10; // Luft rund um das Element

        // Auswahl der Elemente, die der Cursor als Box umschliesst: kleine
        // interaktive Elemente. Serienkarten (.serien-link) sind ausgenommen —
        // dort wirkt der Bild-Invert, kein grosser Kasten um die ganze Karte.
        const BOX_SELEKTOR =
          'a:not(.serien-link):not(.lightbox-flaeche), button, [role="button"], input, label, summary';
        const INTERAKTIV_SELEKTOR = 'a, button, [role="button"], input, label, summary';

        const platziere = () => {
          cursor.style.transform = `translate3d(${istX}px, ${istY}px, 0)`;
        };

        const verstecke = () => {
          sichtbar = false;
          cursor.classList.remove('cursor--sichtbar');
        };

        // Ziel = Mitte des Elements; Punkt auf dessen Grösse/Radius bringen.
        const zielAufBox = () => {
          if (!boxEl) return;
          const r = boxEl.getBoundingClientRect();
          const w = r.width + BOX_PAD * 2;
          const h = r.height + BOX_PAD * 2;
          punkt.style.width = `${w}px`;
          punkt.style.height = `${h}px`;
          punkt.style.borderRadius = `${Math.min(w, h) / 2}px`;
          zielX = r.left + r.width / 2;
          zielY = r.top + r.height / 2;
        };

        // Box lösen: Punkt zurück auf den Kreis (Werte kommen wieder aus dem CSS;
        // backdrop-filter bleibt dauerhaft am Punkt).
        const loeseBox = () => {
          punkt.style.width = '';
          punkt.style.height = '';
          punkt.style.borderRadius = '';
        };

        window.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          mausX = e.clientX;
          mausY = e.clientY;
          if (!sichtbar) {
            sichtbar = true;
            istX = mausX;
            istY = mausY;
            cursor.classList.add('cursor--sichtbar');
          }
          const ziel = e.target instanceof Element ? e.target : null;
          const ueberBild = !!(ziel && ziel.closest('img, picture'));
          const boxZiel = ueberBild ? null : (ziel?.closest(BOX_SELEKTOR) ?? null);

          // Über Fotos: Ball schrumpft zum Punkt, das Bild invertiert (per CSS).
          cursor.classList.toggle('cursor--auf-bild', ueberBild);
          // Box-Modus: der Cursor schwappt in die Umrandung des Elements.
          cursor.classList.toggle('cursor--box', !!boxZiel);
          // Fallback-Vergrösserung nur für interaktive Elemente ohne Box/Bild.
          cursor.classList.toggle(
            'cursor--aktiv',
            !ueberBild && !boxZiel && !!(ziel && ziel.closest(INTERAKTIV_SELEKTOR)),
          );

          if (boxZiel !== boxEl) {
            boxEl = boxZiel;
            if (boxEl) zielAufBox();
            else loeseBox();
          }
          if (!boxEl) {
            zielX = mausX;
            zielY = mausY;
          }

          if (reduziert.matches) {
            if (boxEl) zielAufBox();
            istX = zielX;
            istY = zielY;
            platziere();
          }
        });

        window.addEventListener('pointerdown', () => cursor.classList.add('cursor--druck'));
        window.addEventListener('pointerup', () => cursor.classList.remove('cursor--druck'));
        document.addEventListener('mouseleave', verstecke);
        window.addEventListener('blur', verstecke);

        // Weicher Nachlauf; bei reduzierter Bewegung folgt der Cursor sofort.
        if (!reduziert.matches) {
          const lerp = (a: number, b: number, n: number) => a + (b - a) * n;
          const nachlauf = 0.15; // kleiner = weicherer, längerer Nachlauf
          const schritt = () => {
            // Box beim Scrollen an das Element gebunden halten; verschwindet das
            // Element (z. B. Navigation), zurück in den Freimodus.
            if (boxEl) {
              if (boxEl.isConnected) zielAufBox();
              else {
                boxEl = null;
                loeseBox();
                cursor.classList.remove('cursor--box');
              }
            }
            istX = lerp(istX, zielX, nachlauf);
            istY = lerp(istY, zielY, nachlauf);
            platziere();
            requestAnimationFrame(schritt);
          };
          requestAnimationFrame(schritt);
        }
      }
    </script>

    <script>
      // Invertierender Touch-Kreis — für Touch-Geräte (kein Cursor dort). Ein
      // einzelner transparenter Kreis mit backdrop-filter: invert(1) folgt der
      // Berührung mit etwas Verzögerung (Nachlauf) und verschwindet beim Loslassen.
      // Kein Schweif, keine Maske. Passive Listener — Scrollen bleibt frei.
      const touchGeraet =
        window.matchMedia('(pointer: coarse)').matches ||
        'ontouchstart' in window ||
        navigator.maxTouchPoints > 0;
      const spurReduziert = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (touchGeraet) {
        const kreis = document.createElement('div');
        kreis.className = 'touch-kreis';
        kreis.setAttribute('aria-hidden', 'true');
        // Explizit invert(1) und beide Präfixe — nicht vom CSS-Minifier verändert.
        kreis.style.setProperty('backdrop-filter', 'invert(1)');
        kreis.style.setProperty('-webkit-backdrop-filter', 'invert(1)');
        document.body.appendChild(kreis);

        let zielX = 0;
        let zielY = 0;
        let istX = 0;
        let istY = 0;
        let sichtbar = false;

        const setze = () => {
          kreis.style.transform = `translate3d(${istX}px, ${istY}px, 0)`;
        };

        const beruehrung = (e: TouchEvent) => {
          const t = e.touches[0];
          if (!t) return;
          zielX = t.clientX;
          zielY = t.clientY;
          if (!sichtbar) {
            // Am Berührungspunkt erscheinen (kein Hereinfliegen von 0,0).
            sichtbar = true;
            istX = zielX;
            istY = zielY;
            setze();
            kreis.classList.add('touch-kreis--sichtbar');
          }
          if (spurReduziert.matches) {
            istX = zielX;
            istY = zielY;
            setze();
          }
        };

        const ende = () => {
          sichtbar = false;
          kreis.classList.remove('touch-kreis--sichtbar');
        };

        window.addEventListener('touchstart', beruehrung, { passive: true });
        window.addEventListener('touchmove', beruehrung, { passive: true });
        window.addEventListener('touchend', ende, { passive: true });
        window.addEventListener('touchcancel', ende, { passive: true });

        // Nachlauf: der Kreis zieht der Berührung mit etwas Verzögerung nach.
        if (!spurReduziert.matches) {
          const lerp = (a: number, b: number, n: number) => a + (b - a) * n;
          const nachlauf = 0.18;
          const schritt = () => {
            istX = lerp(istX, zielX, nachlauf);
            istY = lerp(istY, zielY, nachlauf);
            setze();
            requestAnimationFrame(schritt);
          };
          requestAnimationFrame(schritt);
        }
      }
    </script>
  </body>
</html>
