---
import '../styles/tokens.css';
import '../styles/schriften.css';
import '../styles/global.css';

interface Props {
  titel: string;
  beschreibung?: string;
  // Pfad zum Open-Graph-Bild (z. B. aus getImage), wird absolut aufgelöst.
  ogBild?: string;
}

const { titel, beschreibung, ogBild } = Astro.props;

// Absolute URLs für Kanonik und Open Graph.
const kanonisch = new URL(Astro.url.pathname, Astro.site);
const ogBildAbsolut = ogBild ? new URL(ogBild, Astro.site) : undefined;

// Nur für Meta (og:site_name), nicht sichtbar. TODO_NAME bleibt Platzhalter.
const name = 'TODO_NAME';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{titel}</title>
    {beschreibung && <meta name="description" content={beschreibung} />}
    <link rel="canonical" href={kanonisch} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={titel} />
    {beschreibung && <meta property="og:description" content={beschreibung} />}
    <meta property="og:url" content={kanonisch} />
    {ogBildAbsolut && <meta property="og:image" content={ogBildAbsolut} />}
    <meta name="twitter:card" content={ogBildAbsolut ? 'summary_large_image' : 'summary'} />

    <script is:inline>
      // Zugangs-Tor: schon freigeschaltet? Dann sofort ausblenden (kein Aufblitzen).
      try {
        if (localStorage.getItem('tor') === 'auf') document.documentElement.dataset.tor = 'auf';
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Zugangs-Tor (Platzhalter). ACHTUNG: kein echter Schutz auf einer statischen
         Seite — nur eine sichtbare Sperre gegen zufällige Besucher. Siehe docs. -->
    <div id="tor">
      <form id="tor-form" autocomplete="off">
        <input id="tor-code" type="password" autocomplete="off" aria-label="Zugangscode" />
      </form>
    </div>

    <!-- Keine Kopf- und Fusszeile (bewusste Entscheidung des Betreibers).
         Nur die Bilder; grosszügige vertikale Ränder wie Prints an der Wand. -->
    <main class="inhalt">
      <slot />
    </main>

    <style>
      .inhalt {
        flex: 1 0 auto;
        max-width: var(--container);
        width: 100%;
        margin-inline: auto;
        padding-inline: var(--rand);
        padding-block: var(--abstand-64);
      }

      /* Zugangs-Tor (Platzhalter, weiss mit Eingabefeld mittig). Feinschliff folgt. */
      #tor {
        position: fixed;
        inset: 0;
        z-index: var(--z-tor);
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--farbe-hintergrund);
      }
      html[data-tor='auf'] #tor {
        display: none;
      }
      #tor-code {
        width: 14ch;
        padding-block: var(--abstand-8);
        font-family: var(--schrift-mono);
        font-size: var(--groesse-16);
        color: var(--farbe-text);
        text-align: center;
        background: transparent;
        border: none;
        border-bottom: var(--linie-staerke) solid var(--farbe-text);
        outline: none;
        caret-color: var(--farbe-text);
        font-variant-ligatures: none;
      }
      /* Der Touch-Schweif (.spur / .spur__punkt) steht in global.css — die
         Punkte werden per JS erzeugt und tragen kein Astro-Scope-Attribut. */
    </style>

    <script>
      // Zugangs-Tor (Platzhalter). WICHTIG: Auf einer statischen Seite ist das
      // KEIN echter Schutz — Fotos bleiben unter ihren URLs öffentlich abrufbar.
      // Nur eine sichtbare Sperre gegen zufällige Besucher. Code als SHA-256-Hash.
      const TOR_HASH = 'db6b24692506611e2549894ab528b028af27e114f74fabf2fcb2b0e740fe5a04';
      const tor = document.getElementById('tor');
      const torForm = document.getElementById('tor-form');
      const torCode = document.getElementById('tor-code') as HTMLInputElement | null;

      const sha256 = async (text: string) => {
        const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
        return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
      };

      if (document.documentElement.dataset.tor !== 'auf') torCode?.focus();

      torForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!torCode) return;
        if ((await sha256(torCode.value)) === TOR_HASH) {
          try {
            localStorage.setItem('tor', 'auf');
          } catch (err) {}
          document.documentElement.dataset.tor = 'auf';
        } else {
          torCode.value = '';
          tor?.classList.add('tor--falsch');
          setTimeout(() => tor?.classList.remove('tor--falsch'), 400);
        }
      });
    </script>

    <script>
      // Invertierter Cursor — Progressive Enhancement (CLAUDE.md 4a).
      const feinerZeiger = window.matchMedia('(pointer: fine)');
      if (feinerZeiger.matches) {
        const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)');
        const wurzel = document.documentElement;

        const cursor = document.createElement('div');
        cursor.className = 'cursor';
        cursor.setAttribute('aria-hidden', 'true');
        const punkt = document.createElement('span');
        punkt.className = 'cursor__punkt';
        cursor.appendChild(punkt);
        document.body.appendChild(cursor);
        wurzel.classList.add('cursor-aktiv');

        let zielX = window.innerWidth / 2;
        let zielY = window.innerHeight / 2;
        let istX = zielX;
        let istY = zielY;
        let sichtbar = false;

        const platziere = () => {
          cursor.style.transform = `translate3d(${istX}px, ${istY}px, 0)`;
        };

        const verstecke = () => {
          sichtbar = false;
          cursor.classList.remove('cursor--sichtbar');
        };

        window.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          zielX = e.clientX;
          zielY = e.clientY;
          if (!sichtbar) {
            sichtbar = true;
            istX = zielX;
            istY = zielY;
            cursor.classList.add('cursor--sichtbar');
          }
          const ziel = e.target instanceof Element ? e.target : null;
          const ueberBild = !!(ziel && ziel.closest('img, picture'));
          const interaktiv = !!(
            ziel && ziel.closest('a, button, [role="button"], input, label, summary')
          );
          // Über Fotos: Ball schrumpft zum Punkt, das Bild invertiert (per CSS).
          cursor.classList.toggle('cursor--auf-bild', ueberBild);
          // Über interaktiven Elementen (aber nicht über Fotos) vergrössern.
          cursor.classList.toggle('cursor--aktiv', interaktiv && !ueberBild);
          if (reduziert.matches) {
            istX = zielX;
            istY = zielY;
            platziere();
          }
        });

        window.addEventListener('pointerdown', () => cursor.classList.add('cursor--druck'));
        window.addEventListener('pointerup', () => cursor.classList.remove('cursor--druck'));
        document.addEventListener('mouseleave', verstecke);
        window.addEventListener('blur', verstecke);

        // Weicher Nachlauf; bei reduzierter Bewegung folgt der Cursor sofort.
        if (!reduziert.matches) {
          const lerp = (a: number, b: number, n: number) => a + (b - a) * n;
          const nachlauf = 0.15; // kleiner = weicherer, längerer Nachlauf
          const schritt = () => {
            istX = lerp(istX, zielX, nachlauf);
            istY = lerp(istY, zielY, nachlauf);
            platziere();
            requestAnimationFrame(schritt);
          };
          requestAnimationFrame(schritt);
        }
      }
    </script>

    <script>
      // Invertierter Touch-Schweif — für Touch-Geräte (kein Cursor dort).
      // Bei Berührung/Bewegung entstehen invertierende Punkte, die schnell
      // verblassen und der Bewegung als Schweif nachziehen. Reine Zutat.
      const touchGeraet =
        window.matchMedia('(pointer: coarse)').matches ||
        'ontouchstart' in window ||
        navigator.maxTouchPoints > 0;
      const spurReduziert = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (touchGeraet && !spurReduziert.matches) {
        const schicht = document.createElement('div');
        schicht.className = 'spur';
        schicht.setAttribute('aria-hidden', 'true');
        document.body.appendChild(schicht);

        const tupfen = (x: number, y: number) => {
          const punkt = document.createElement('span');
          punkt.className = 'spur__punkt';
          punkt.style.left = `${x}px`;
          punkt.style.top = `${y}px`;
          punkt.addEventListener('animationend', () => punkt.remove());
          schicht.appendChild(punkt);
        };

        let letzteZeit = 0;
        const beruehrung = (e: TouchEvent) => {
          const jetzt = performance.now();
          if (jetzt - letzteZeit < 16) return; // drosseln (~60/s)
          letzteZeit = jetzt;
          for (let i = 0; i < e.touches.length; i++) {
            const t = e.touches[i];
            tupfen(t.clientX, t.clientY);
          }
        };

        // passive: true — Scrollen wird nicht blockiert.
        window.addEventListener('touchstart', beruehrung, { passive: true });
        window.addEventListener('touchmove', beruehrung, { passive: true });
      }
    </script>
  </body>
</html>
