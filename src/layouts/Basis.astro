---
import '../styles/tokens.css';
import '../styles/schriften.css';
import '../styles/global.css';

interface Props {
  titel: string;
  beschreibung?: string;
  // Pfad zum Open-Graph-Bild (z. B. aus getImage), wird absolut aufgelöst.
  ogBild?: string;
}

const { titel, beschreibung, ogBild } = Astro.props;

// Absolute URLs für Kanonik und Open Graph.
const kanonisch = new URL(Astro.url.pathname, Astro.site);
const ogBildAbsolut = ogBild ? new URL(ogBild, Astro.site) : undefined;

// Nur für Meta (og:site_name), nicht sichtbar. TODO_NAME bleibt Platzhalter.
const name = 'TODO_NAME';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{titel}</title>
    {beschreibung && <meta name="description" content={beschreibung} />}
    <link rel="canonical" href={kanonisch} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={titel} />
    {beschreibung && <meta property="og:description" content={beschreibung} />}
    <meta property="og:url" content={kanonisch} />
    {ogBildAbsolut && <meta property="og:image" content={ogBildAbsolut} />}
    <meta name="twitter:card" content={ogBildAbsolut ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <!-- Keine Kopf- und Fusszeile (bewusste Entscheidung des Betreibers).
         Nur die Bilder; grosszügige vertikale Ränder wie Prints an der Wand. -->
    <main class="inhalt">
      <slot />
    </main>

    <style>
      .inhalt {
        flex: 1 0 auto;
        max-width: var(--container);
        width: 100%;
        margin-inline: auto;
        padding-inline: var(--rand);
        padding-block: var(--abstand-64);
      }
    </style>

    <script>
      // Invertierter Cursor — Progressive Enhancement (CLAUDE.md 4a).
      // Einziges clientseitiges Skript. Ohne JavaScript passiert nichts.
      const feinerZeiger = window.matchMedia('(pointer: fine)');
      if (feinerZeiger.matches) {
        const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)');
        const wurzel = document.documentElement;

        const cursor = document.createElement('div');
        cursor.className = 'cursor';
        cursor.setAttribute('aria-hidden', 'true');
        const punkt = document.createElement('span');
        punkt.className = 'cursor__punkt';
        cursor.appendChild(punkt);
        document.body.appendChild(cursor);
        wurzel.classList.add('cursor-aktiv');

        let zielX = window.innerWidth / 2;
        let zielY = window.innerHeight / 2;
        let istX = zielX;
        let istY = zielY;
        let sichtbar = false;

        const platziere = () => {
          cursor.style.transform = `translate3d(${istX}px, ${istY}px, 0)`;
        };

        const verstecke = () => {
          sichtbar = false;
          cursor.classList.remove('cursor--sichtbar');
        };

        window.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          zielX = e.clientX;
          zielY = e.clientY;
          if (!sichtbar) {
            sichtbar = true;
            istX = zielX;
            istY = zielY;
            cursor.classList.add('cursor--sichtbar');
          }
          const ziel = e.target instanceof Element ? e.target : null;
          const ueberBild = !!(ziel && ziel.closest('img, picture'));
          const interaktiv = !!(
            ziel && ziel.closest('a, button, [role="button"], input, label, summary')
          );
          // Über Fotos: Ball schrumpft zum Punkt, das Bild invertiert (per CSS).
          cursor.classList.toggle('cursor--auf-bild', ueberBild);
          // Über interaktiven Elementen (aber nicht über Fotos) vergrössern.
          cursor.classList.toggle('cursor--aktiv', interaktiv && !ueberBild);
          if (reduziert.matches) {
            istX = zielX;
            istY = zielY;
            platziere();
          }
        });

        window.addEventListener('pointerdown', () => cursor.classList.add('cursor--druck'));
        window.addEventListener('pointerup', () => cursor.classList.remove('cursor--druck'));
        document.addEventListener('mouseleave', verstecke);
        window.addEventListener('blur', verstecke);

        // Weicher Nachlauf; bei reduzierter Bewegung folgt der Cursor sofort.
        if (!reduziert.matches) {
          const lerp = (a: number, b: number, n: number) => a + (b - a) * n;
          const nachlauf = 0.15; // kleiner = weicherer, längerer Nachlauf
          const schritt = () => {
            istX = lerp(istX, zielX, nachlauf);
            istY = lerp(istY, zielY, nachlauf);
            platziere();
            requestAnimationFrame(schritt);
          };
          requestAnimationFrame(schritt);
        }
      }
    </script>
  </body>
</html>
