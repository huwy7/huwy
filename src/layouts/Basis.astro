---
import '../styles/tokens.css';
import '../styles/schriften.css';
import '../styles/global.css';

interface Props {
  titel: string;
  beschreibung?: string;
  // Pfad zum Open-Graph-Bild (z. B. aus getImage), wird absolut aufgelöst.
  ogBild?: string;
  // Abstände als Token-Referenzen (kein roher Wert). Vorgabe: 48px oben
  // (Startseite, 6.1), 64px unten. Serienseite überschreibt oben mit 64px.
  abstandOben?: string;
  abstandUnten?: string;
}

const {
  titel,
  beschreibung,
  ogBild,
  abstandOben = 'var(--abstand-48)',
  abstandUnten = 'var(--abstand-64)',
} = Astro.props;
const jahr = new Date().getFullYear();

// Absolute URLs für Kanonik und Open Graph. Astro.site ist TODO_DOMAIN, bis die
// echte Domain eingetragen ist — Struktur stimmt, Wert folgt.
const kanonisch = new URL(Astro.url.pathname, Astro.site);
const ogBildAbsolut = ogBild ? new URL(ogBild, Astro.site) : undefined;

// TODO_NAME, TODO_MAIL, TODO_INSTAGRAM: Platzhalter (CLAUDE.md Abschnitt 2).
// TODO_INSTAGRAM ist in CLAUDE.md nicht aufgeführt, wird aber in Spezifikation
// 6.1/6.4 gebraucht — Wert liefert der Betreiber.
const name = 'TODO_NAME';

const navLinks = [
  { href: '/', text: 'Serien' },
  { href: '/ueber', text: 'Über' },
  { href: '/kontakt', text: 'Kontakt' },
];

const fussLinks = [
  { href: 'mailto:TODO_MAIL', text: 'Mail' },
  { href: 'TODO_INSTAGRAM', text: 'Instagram' },
  { href: '/impressum', text: 'Impressum' },
  { href: '/datenschutz', text: 'Datenschutz' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{titel}</title>
    {beschreibung && <meta name="description" content={beschreibung} />}
    <link rel="canonical" href={kanonisch} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={titel} />
    {beschreibung && <meta property="og:description" content={beschreibung} />}
    <meta property="og:url" content={kanonisch} />
    {ogBildAbsolut && <meta property="og:image" content={ogBildAbsolut} />}
    <meta name="twitter:card" content={ogBildAbsolut ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#hauptinhalt">Zum Inhalt springen</a>

    <header class="kopf">
      <a class="wortmarke" href="/">{name}</a>
      <nav class="navigation" aria-label="Hauptnavigation">
        {
          navLinks.map((link, i) => (
            <>
              {i > 0 && (
                <span class="trenner" aria-hidden="true">
                  ·
                </span>
              )}
              <a href={link.href}>{link.text}</a>
            </>
          ))
        }
      </nav>
    </header>

    <main id="hauptinhalt" class="inhalt" style={`padding-block-start: ${abstandOben};`}>
      <slot />
    </main>

    <footer class="fuss" style={`margin-block-start: ${abstandUnten};`}>
      <nav class="fuss-links" aria-label="Kontakt und Rechtliches">
        {
          fussLinks.map((link, i) => (
            <>
              {i > 0 && (
                <span class="trenner" aria-hidden="true">
                  ·
                </span>
              )}
              <a href={link.href}>{link.text}</a>
            </>
          ))
        }
      </nav>
      <p class="fuss-copy">© {name}, {jahr}</p>
    </footer>

    <style>
      /* Skip-Link: sitzt oberhalb des Viewports, wird bei Fokus sichtbar. */
      .skip-link {
        position: absolute;
        left: var(--abstand-8);
        top: calc(-1 * var(--header-hoehe));
        z-index: 1;
        background-color: var(--farbe-hintergrund);
        color: var(--farbe-text);
        font-family: var(--schrift-mono);
        font-size: var(--groesse-14);
        font-variant-ligatures: none;
        padding: var(--abstand-8) var(--abstand-16);
      }
      .skip-link:focus {
        top: var(--abstand-8);
      }

      /* --- Header (Spezifikation 6.1) --- */
      .kopf {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--abstand-16);
        min-height: var(--header-hoehe);
        max-width: var(--container);
        margin-inline: auto;
        padding-inline: var(--rand);
      }

      .wortmarke {
        font-family: var(--schrift-mono);
        font-size: var(--groesse-15);
        font-weight: var(--gewicht-500);
        line-height: var(--zeilenhoehe-1-2);
        font-variant-ligatures: none;
        text-decoration: none;
      }

      .navigation {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--abstand-16);
        font-family: var(--schrift-mono);
        font-size: var(--groesse-14);
        font-weight: var(--gewicht-400);
        line-height: var(--zeilenhoehe-1-2);
        font-variant-ligatures: none;
      }

      .trenner {
        color: var(--farbe-text-leise);
      }

      /* --- Inhalt --- */
      .inhalt {
        flex: 1 0 auto;
        max-width: var(--container);
        width: 100%;
        margin-inline: auto;
        padding-inline: var(--rand);
        /* padding-block-start wird per Prop abstandOben inline gesetzt. */
      }

      /* --- Fusszeile (Spezifikation 6.1) --- */
      .fuss {
        flex-shrink: 0;
        max-width: var(--container);
        width: 100%;
        margin-inline: auto;
        padding-inline: var(--rand);
        /* margin-block-start wird per Prop abstandUnten inline gesetzt. */
        border-top: var(--linie-staerke) solid var(--farbe-linie);
        padding-block-start: var(--abstand-32);
        padding-block-end: var(--abstand-64);
        font-family: var(--schrift-mono);
        font-size: var(--groesse-12);
        font-weight: var(--gewicht-400);
        line-height: var(--zeilenhoehe-1-5);
        color: var(--farbe-text-leise);
        font-variant-ligatures: none;
      }

      .fuss-links {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--abstand-16);
        margin-block-end: var(--abstand-8);
      }

      /* Fusszeilen-Links tragen die leise Meta-Farbe (Spezifikation 3.4),
         bleiben aber unterstrichen (Spezifikation 2). */
      .fuss a {
        color: var(--farbe-text-leise);
      }
    </style>

    <script>
      // Invertierter Cursor — Progressive Enhancement (CLAUDE.md 4a).
      // Einziges clientseitiges Skript. Ohne JavaScript passiert nichts.
      const feinerZeiger = window.matchMedia('(pointer: fine)');
      if (feinerZeiger.matches) {
        const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)');
        const wurzel = document.documentElement;

        const cursor = document.createElement('div');
        cursor.className = 'cursor';
        cursor.setAttribute('aria-hidden', 'true');
        const punkt = document.createElement('span');
        punkt.className = 'cursor__punkt';
        cursor.appendChild(punkt);
        document.body.appendChild(cursor);
        wurzel.classList.add('cursor-aktiv');

        let zielX = window.innerWidth / 2;
        let zielY = window.innerHeight / 2;
        let istX = zielX;
        let istY = zielY;
        let sichtbar = false;

        const platziere = () => {
          cursor.style.transform = `translate3d(${istX}px, ${istY}px, 0)`;
        };

        const verstecke = () => {
          sichtbar = false;
          cursor.classList.remove('cursor--sichtbar');
        };

        window.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          zielX = e.clientX;
          zielY = e.clientY;
          if (!sichtbar) {
            sichtbar = true;
            istX = zielX;
            istY = zielY;
            cursor.classList.add('cursor--sichtbar');
          }
          const ziel = e.target instanceof Element ? e.target : null;
          const ueberBild = !!(ziel && ziel.closest('img, picture'));
          const interaktiv = !!(
            ziel && ziel.closest('a, button, [role="button"], input, label, summary')
          );
          // Über Fotos: Ball schrumpft zum Punkt, das Bild invertiert (per CSS).
          cursor.classList.toggle('cursor--auf-bild', ueberBild);
          // Über interaktiven Elementen (aber nicht über Fotos) vergrössern.
          cursor.classList.toggle('cursor--aktiv', interaktiv && !ueberBild);
          if (reduziert.matches) {
            istX = zielX;
            istY = zielY;
            platziere();
          }
        });

        window.addEventListener('pointerdown', () => cursor.classList.add('cursor--druck'));
        window.addEventListener('pointerup', () => cursor.classList.remove('cursor--druck'));
        document.addEventListener('mouseleave', verstecke);
        window.addEventListener('blur', verstecke);

        // Weicher Nachlauf; bei reduzierter Bewegung folgt der Cursor sofort.
        if (!reduziert.matches) {
          const lerp = (a: number, b: number, n: number) => a + (b - a) * n;
          const nachlauf = 0.15; // kleiner = weicherer, längerer Nachlauf
          const schritt = () => {
            istX = lerp(istX, zielX, nachlauf);
            istY = lerp(istY, zielY, nachlauf);
            platziere();
            requestAnimationFrame(schritt);
          };
          requestAnimationFrame(schritt);
        }
      }
    </script>
  </body>
</html>
