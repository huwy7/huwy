---
import '../styles/tokens.css';
import '../styles/schriften.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import torBild from '../assets/tor.jpeg';

interface Props {
  titel: string;
  beschreibung?: string;
  // Pfad zum Open-Graph-Bild (z. B. aus getImage), wird absolut aufgelöst.
  ogBild?: string;
  // Modus: 'duester' (Standard, Schwarzweiss) oder 'farbe' (farbige Unterseite).
  // Steuert Theme (data-modus), Kopfzeilen-Layout (gespiegelt) und Ziele.
  modus?: 'duester' | 'farbe';
  // Galerie-Seiten (Karussell) bringen ihre volle Höhe je Serie selbst mit —
  // dann ohne zusätzlichen vertikalen Innenabstand, damit das erste Bild nicht
  // knapp abgeschnitten wird.
  vollhoehe?: boolean;
}

const { titel, beschreibung, ogBild, modus = 'duester', vollhoehe = false } = Astro.props;

// Modus-abhängige Navigation. Farbmodus ist gespiegelt (Menü rechts, Umschalt-
// Button links); Beschriftungen englisch, nur der Umschalt-Button spanisch.
// Alle internen Ziele über die Astro-Basis aufbauen, damit die /feature-Vorschau
// in sich navigiert und main ('/') unverändert bleibt. BASE_URL kann mit oder ohne
// End-Slash kommen ('/' bei main, '/feature' beim Feature-Branch) — darum den
// End-Slash abziehen und die Pfade mit führendem Slash anhängen.
const b = import.meta.env.BASE_URL.replace(/\/$/, ''); // '' oder '/feature'
const farbe = modus === 'farbe';
const portfolioZiel = farbe ? `${b}/color` : `${b}/`;
const aboutZiel = farbe ? `${b}/color/ueber-mich` : `${b}/ueber-mich`;
const aboutLabel = farbe ? 'More about me' : 'About me';
const switchZiel = farbe ? `${b}/` : `${b}/color`;
// Spanisch, augenzwinkernd — als Einladung/Frage. Nur diese Buttons sind spanisch.
const switchLabel = farbe ? 'A mí me gusta la noche' : '¿A quién le gusta el sol?';

// Hintergrund des Zugangs-Tors: das raue Schwarzweiss-Foto (grain, düster —
// CLAUDE.md 1a) füllt den Bildschirm formatunabhängig (cover). Optimiert über
// astro:assets zu AVIF/WebP; per image-set wählt der Browser das kleinste Format.
const torAvif = await getImage({ src: torBild, format: 'avif', quality: 62 });
const torWebp = await getImage({ src: torBild, format: 'webp', quality: 80 });
const torHintergrund = `image-set(url("${torAvif.src}") type("image/avif"), url("${torWebp.src}") type("image/webp"))`;

// --tor-bg trägt den Sperrbildschirm-Hund (beide Modi). Der Farbmodus hat einen
// schlichten weissen Grund (global.css) — kein eigenes Hintergrundbild mehr.
const bodyStil = `--tor-bg: ${torHintergrund}`;

// Aktive Navigation (nur aria-current, keine farbliche Hervorhebung mehr). Den
// Basis-Pfad abziehen, damit die Erkennung auch unter /feature stimmt.
const rel = (Astro.url.pathname.slice(b.length) || '/').replace(/(.)\/$/, '$1');
const istPortfolio = farbe ? rel === '/color' : rel === '/';
const istUeber = farbe ? rel === '/color/ueber-mich' : rel === '/ueber-mich';

// Absolute URLs für Kanonik und Open Graph.
const kanonisch = new URL(Astro.url.pathname, Astro.site);
const ogBildAbsolut = ogBild ? new URL(ogBild, Astro.site) : undefined;

// Nur für Meta (og:site_name), nicht sichtbar. TODO_NAME bleibt Platzhalter.
const name = 'TODO_NAME';
---

<!doctype html>
<html lang="de" data-modus={modus}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{titel}</title>
    {beschreibung && <meta name="description" content={beschreibung} />}
    <link rel="canonical" href={kanonisch} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={titel} />
    {beschreibung && <meta property="og:description" content={beschreibung} />}
    <meta property="og:url" content={kanonisch} />
    {ogBildAbsolut && <meta property="og:image" content={ogBildAbsolut} />}
    <meta name="twitter:card" content={ogBildAbsolut ? 'summary_large_image' : 'summary'} />

    <script is:inline>
      // Zugangs-Tor: in dieser Sitzung schon freigeschaltet? Dann sofort ausblenden
      // (kein Aufblitzen). sessionStorage statt localStorage — die Freischaltung gilt
      // nur für den aktuellen Besuch (Tab/Sitzung). Bei jedem neuen Aufruf der Seite
      // wird der Code wieder verlangt.
      try {
        if (sessionStorage.getItem('tor') === 'auf') document.documentElement.dataset.tor = 'auf';
      } catch (e) {}

      // Seite immer zuoberst öffnen: die automatische Scroll-Wiederherstellung des
      // Browsers abschalten und bei jedem Seitenaufruf (auch aus dem bfcache) nach
      // oben scrollen. Reine Progressive Enhancement — ohne JS lädt die Seite wie
      // gehabt, nur ohne diesen Reset.
      try {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      } catch (e) {}
      addEventListener('pageshow', function () {
        window.scrollTo(0, 0);
      });
    </script>
  </head>
  <body style={bodyStil}>
    <!-- Zugangs-Tor (Platzhalter). ACHTUNG: kein echter Schutz auf einer statischen
         Seite — nur eine sichtbare Sperre gegen zufällige Besucher. Siehe docs.
         --tor-bg steht auf <body>, damit auch der verwischte Seitenhintergrund
         (global.css body::before) dieselbe Bilddatei nutzt. -->
    <div id="tor">
      <form id="tor-form" autocomplete="off">
        <input id="tor-code" type="password" autocomplete="off" aria-label="Zugangscode" />
      </form>
    </div>

    <!-- Kopfzeile: Portfolio + About me, dazu der Modus-Umschalt-Button. Gespiegelt
         je Modus (düster: Menü links / Button rechts; farbig: Button links / Menü
         rechts). Schlicht, mono, Fokus bleibt auf den Bildern. -->
    <header class="kopf">
      {
        farbe ? (
          <>
            <a class="kopf-switch" href={switchZiel}>
              {switchLabel}
            </a>
            <nav class="kopf-nav" aria-label="Hauptnavigation">
              <a href={aboutZiel} aria-current={istUeber ? 'page' : undefined}>
                {aboutLabel}
              </a>
              <a href={portfolioZiel} aria-current={istPortfolio ? 'page' : undefined}>
                Portfolio
              </a>
            </nav>
          </>
        ) : (
          <>
            <nav class="kopf-nav" aria-label="Hauptnavigation">
              <a href={portfolioZiel} aria-current={istPortfolio ? 'page' : undefined}>
                Portfolio
              </a>
              <a href={aboutZiel} aria-current={istUeber ? 'page' : undefined}>
                {aboutLabel}
              </a>
            </nav>
            <a class="kopf-switch" href={switchZiel}>
              {switchLabel}
            </a>
          </>
        )
      }
    </header>

    <main class:list={['inhalt', { 'inhalt--voll': vollhoehe }]}>
      <slot />
    </main>

    <style>
      /* Kopfzeile: gleicher Rasterrahmen wie der Inhalt, schlicht und mono. Menü und
         Umschalt-Button sitzen an den beiden Enden (space-between) — dadurch ist die
         Kopfzeile im Farbmodus automatisch gespiegelt (dort steht der Button zuerst
         im Markup, also links, das Menü rechts). */
      .kopf {
        /* Bleibt beim Scrollen immer sichtbar. Der Schleier (Verlauf) sorgt dafür,
           dass die Beschriftungen lesbar bleiben, wenn ein Foto darunter
           durchscrollt — kein harter Balken, die Seite bleibt ruhig. Unter dem
           Vollbild (--z-lightbox) und dem Cursor, damit beide darüber liegen. */
        position: sticky;
        top: 0;
        z-index: var(--z-kopf);
        background-image: var(--kopf-schleier);
        display: flex;
        flex-wrap: wrap; /* langer spanischer Button rutscht bei Bedarf in eine 2. Zeile */
        justify-content: space-between;
        align-items: center;
        gap: var(--abstand-8) var(--abstand-24);
        /* Der Schleier läuft über die volle Breite (sonst endete er sichtbar an der
           Container-Kante). Der Inhalt bleibt trotzdem exakt am selben Raster wie
           .inhalt: der Innenabstand rechnet den Container-Rand mit ein. */
        width: 100%;
        padding-inline: max(var(--rand), calc((100% - var(--container)) / 2 + var(--rand)));
        padding-block: var(--abstand-24);
      }

      /* Beim Umbruch (schmale Screens) rutscht das zweite Element in eine zweite
         Zeile. Damit bleibt es rechtsbündig (düster: Umschalt-Button, farbig:
         Navigation) — die gespiegelte Anordnung bleibt erhalten, statt dass beide
         Zeilen links untereinander kleben. Auf einer Zeile wirkt es wie
         space-between. */
      .kopf > :last-child {
        margin-inline-start: auto;
      }

      .kopf-nav {
        display: flex;
        gap: var(--abstand-24);
      }

      /* Beschriftungen brechen nicht mitten im Wort/Satz um; lieber die ganze
         Gruppe in eine neue Zeile (via flex-wrap oben). */
      .kopf-nav a,
      .kopf-switch {
        white-space: nowrap;
      }

      .kopf-nav,
      .kopf-switch {
        font-family: var(--schrift-mono);
        font-size: var(--groesse-14);
        line-height: var(--zeilenhoehe-1-4);
        font-variant-ligatures: none;
      }

      /* Alle Beschriftungen einheitlich weiss (keine unterschiedlichen Töne).
         Die aktive Seite wird nicht mehr über die Farbe hervorgehoben; das
         aria-current-Attribut bleibt für Screenreader erhalten. */
      .kopf-nav a,
      .kopf-switch {
        color: var(--farbe-text);
        text-decoration: none;
      }

      /* Mobil: alles bleibt in EINER Zeile — der Umschalt-Button steht neben der
         Navigation, nicht darunter. Damit der lange spanische Text danebenpasst,
         wird die Kopfzeile hier eine Stufe kleiner gesetzt und die Abstände enger.
         Anordnung und Spiegelung (düster: Menü links, farbig: Button links) bleiben
         wie am Desktop. */
      @media (max-width: 768px) {
        .kopf {
          flex-wrap: nowrap;
          gap: var(--abstand-16);
        }
        .kopf-nav {
          gap: var(--abstand-16);
        }
        .kopf-nav,
        .kopf-switch {
          font-size: var(--groesse-12);
        }
      }

      .inhalt {
        flex: 1 0 auto;
        max-width: var(--container);
        width: 100%;
        margin-inline: auto;
        padding-inline: var(--rand);
        padding-block: var(--abstand-64);
      }
      /* Galerie-Seiten: kein vertikaler Innenabstand — jede Serie ist eine volle
         Bildschirmhöhe hoch und zentriert sich selbst. */
      .inhalt--voll {
        padding-block: 0;
      }

      /* Zugangs-Tor: das raue Schwarzweiss-Foto füllt den Bildschirm (cover),
         formatunabhängig zentriert. Darüber ein weicher, mittiger Dunkel-Schleier,
         damit das Eingabefeld auch über hellen Bildpartien (Zähne) lesbar bleibt —
         der Rand des Fotos bleibt kräftig. Fällt image-set aus, greift die
         near-black Grundfarbe. */
      #tor {
        position: fixed;
        inset: 0;
        z-index: var(--z-tor);
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--farbe-hintergrund);
        background-image:
          radial-gradient(
            ellipse at center,
            rgba(0, 0, 0, 0.62) 0%,
            rgba(0, 0, 0, 0.2) 45%,
            rgba(0, 0, 0, 0) 72%
          ),
          var(--tor-bg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      }
      /* Hochkant: der zentrierte Ausschnitt zeigt v. a. Auge/Wange, die Zähne nur
         am Rand. Das Bild etwas nach rechts Richtung Schnauze schieben, damit mehr
         vom Hundegebiss sichtbar ist. Nur Position — keine Bildbearbeitung. Nur
         Hochformat; Querformat bleibt zentriert. Der Dunkel-Schleier (erste Ebene)
         bleibt mittig hinter dem Eingabefeld, nur das Foto (zweite Ebene) wandert. */
      @media (orientation: portrait) {
        #tor {
          background-position: center, 72% center;
        }
      }
      /* Weicher Übergang: der scharfe Sperrbildschirm blendet auf den Portfolio-
         Hintergrund (dasselbe Bild, blur+grain aus body::before) über. Erst danach
         wird der Inhalt gezeigt — Zeit, in der die Bilder laden. */
      #tor {
        transition: opacity 0.9s ease;
      }
      #tor.tor--zu {
        opacity: 0;
        pointer-events: none;
      }
      html[data-tor='auf'] #tor {
        display: none;
      }
      /* Inhalt nach der Blende sanft einblenden (nur beim Live-Entsperren, Klasse
         .weich); bei bereits freigeschalteter Sitzung erscheint er ohne Animation. */
      html.weich .kopf,
      html.weich .inhalt {
        animation: inhalt-ein 0.7s ease both;
      }
      @keyframes inhalt-ein {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        #tor {
          transition: none;
        }
        html.weich .kopf,
        html.weich .inhalt {
          animation: none;
        }
      }
      /* Solange gesperrt (Tor sichtbar): den eigentlichen Inhalt ausblenden und
         den Body nicht scrollen. Sonst blitzt beim Drehen des Geräts (iOS legt
         fixe Elemente kurz neu an) die echte Seite hinter dem Tor auf. Der Grund
         (Hund/Grain aus body::before/::after) bleibt — er gehört zum Tor-Look. */
      html:not([data-tor='auf']) body {
        overflow: hidden;
      }
      html:not([data-tor='auf']) .kopf,
      html:not([data-tor='auf']) .inhalt {
        visibility: hidden;
      }
      /* Eingabefeld als Box mit Invert-Effekt: weisse Fläche + mix-blend-mode:
         difference wirkt wie eine transparente, invertierte Box (dasselbe Prinzip
         wie der Cursor). Der Untergrund (Foto) erscheint im Kasten invertiert;
         Text und Cursor in near-black kontrastieren dadurch immer. Harte Kante,
         kein Rahmen nötig — die invertierte Fläche ist die Box. */
      #tor-code {
        width: 14ch;
        padding: var(--abstand-8) var(--abstand-16);
        font-family: var(--schrift-mono);
        font-size: var(--groesse-16);
        color: var(--farbe-hintergrund);
        text-align: center;
        background: var(--farbe-rahmen);
        mix-blend-mode: difference;
        border: none;
        border-radius: 0;
        outline: none;
        caret-color: var(--farbe-hintergrund);
        font-variant-ligatures: none;
      }
      /* Der Touch-Schweif (.spur / .spur__punkt) steht in global.css — die
         Punkte werden per JS erzeugt und tragen kein Astro-Scope-Attribut. */
    </style>

    <script>
      // Zugangs-Tor (Platzhalter). WICHTIG: Auf einer statischen Seite ist das
      // KEIN echter Schutz — Fotos bleiben unter ihren URLs öffentlich abrufbar.
      // Nur eine sichtbare Sperre gegen zufällige Besucher. Code als SHA-256-Hash.
      const TOR_HASH = 'db6b24692506611e2549894ab528b028af27e114f74fabf2fcb2b0e740fe5a04';
      const tor = document.getElementById('tor');
      const torForm = document.getElementById('tor-form');
      const torCode = document.getElementById('tor-code') as HTMLInputElement | null;

      const wurzel = document.documentElement;

      const sha256 = async (text: string) => {
        const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
        return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
      };

      // Aufgeschobene Bilder aktivieren: die echten Quellen (data-srcset/data-src)
      // ins Markup setzen, sodass sie erst JETZT laden. Reihenfolge = DOM-Reihenfolge,
      // also Serie eins zuerst, danach die folgenden Serien (logische Reihenfolge).
      // Am Sperrbildschirm passiert das nicht — dort lädt kein Foto.
      let bilderAktiv = false;
      const aktiviereBilder = () => {
        if (bilderAktiv) return;
        bilderAktiv = true;
        for (const pic of document.querySelectorAll('picture.bild-defer')) {
          for (const q of pic.querySelectorAll('source[data-srcset]')) {
            const ds = q.getAttribute('data-srcset');
            if (ds) q.setAttribute('srcset', ds);
            q.removeAttribute('data-srcset');
          }
          const img = pic.querySelector('img');
          if (!img) continue;
          const fertig = () => img.classList.add('geladen');
          img.addEventListener('load', fertig, { once: true });
          img.addEventListener('error', fertig, { once: true });
          if (img.dataset.srcset) {
            img.srcset = img.dataset.srcset;
            delete img.dataset.srcset;
          }
          if (img.dataset.src) {
            img.src = img.dataset.src;
            delete img.dataset.src;
          }
        }
      };

      const nachOben = () => {
        window.scrollTo(0, 0);
        requestAnimationFrame(() => window.scrollTo(0, 0));
      };

      // Weicher Übergang vom scharfen Sperrbildschirm auf den blur+grain-Hintergrund
      // (dasselbe Bild). Während der Blende laden die Bilder; danach erscheint der
      // Inhalt — die Fotos sind dann fertig und blenden sofort ein.
      const entsperren = () => {
        aktiviereBilder();
        tor?.classList.add('tor--zu');
        let erledigt = false;
        const abschluss = () => {
          if (erledigt) return;
          erledigt = true;
          wurzel.dataset.tor = 'auf';
          wurzel.classList.add('weich');
          // Klasse nach dem Einblenden wieder entfernen. Die Animation läuft mit
          // fill-mode „both" und bliebe sonst dauerhaft in Kraft — ein Element mit
          // filternder/animierter Deckkraft bildet einen eigenen Stacking-Context,
          // in dem die Vollbild-Ansicht gefangen bliebe (sie läge dann UNTER der
          // sticky Kopfzeile). Nach dem Entfernen ist die Deckkraft wieder 1,
          // also kein Sprung, aber auch kein Stacking-Context mehr.
          setTimeout(() => wurzel.classList.remove('weich'), 900);
          nachOben();
        };
        tor?.addEventListener('transitionend', abschluss, { once: true });
        setTimeout(abschluss, 1000);
      };

      // Schon in dieser Sitzung freigeschaltet? Dann sofort laden (keine Blende).
      // Sonst: nur bei feinem Zeiger (Desktop) fokussieren — auf Touch würde das
      // die Tastatur öffnen und den Viewport verschieben.
      if (wurzel.dataset.tor === 'auf') aktiviereBilder();
      else if (window.matchMedia('(pointer: fine)').matches) torCode?.focus();

      torForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!torCode) return;
        if ((await sha256(torCode.value)) === TOR_HASH) {
          try {
            // Nur für den aktuellen Besuch merken (sessionStorage).
            sessionStorage.setItem('tor', 'auf');
          } catch (err) {}
          torCode.blur();
          entsperren();
        } else {
          torCode.value = '';
          tor?.classList.add('tor--falsch');
          setTimeout(() => tor?.classList.remove('tor--falsch'), 400);
        }
      });
    </script>

    <script>
      // Invertierter Cursor — Progressive Enhancement (CLAUDE.md 4a).
      const feinerZeiger = window.matchMedia('(pointer: fine)');
      if (feinerZeiger.matches) {
        const reduziert = window.matchMedia('(prefers-reduced-motion: reduce)');
        const wurzel = document.documentElement;

        const cursor = document.createElement('div');
        cursor.className = 'cursor';
        cursor.setAttribute('aria-hidden', 'true');
        const punkt = document.createElement('span');
        punkt.className = 'cursor__punkt';
        // Transparente Fläche mit backdrop-filter. Düster: invert(1) (kehrt den
        // Untergrund inkl. Farben um). Farbseite: grayscale(1) invert(1) — ein
        // Schwarz-Weiss-Invert: nimmt den Farben die Farbe (kein greller
        // Farb-Negativ mehr) UND invertiert, damit der Kreis auch über Weiss
        // (→ dunkel) und Schwarz (→ hell) sichtbar bleibt und Text darunter lesbar
        // ist. Inline gesetzt, da der CSS-Minifier den Wert verändern würde.
        const cursorFilter =
          document.documentElement.dataset.modus === 'farbe'
            ? 'grayscale(1) invert(1)'
            : 'invert(1)';
        punkt.style.setProperty('backdrop-filter', cursorFilter);
        punkt.style.setProperty('-webkit-backdrop-filter', cursorFilter);
        cursor.appendChild(punkt);
        document.body.appendChild(cursor);
        wurzel.classList.add('cursor-aktiv');

        let zielX = window.innerWidth / 2;
        let zielY = window.innerHeight / 2;
        let istX = zielX;
        let istY = zielY;
        let mausX = zielX; // letzte Zeigerposition (Freimodus)
        let mausY = zielY;
        let sichtbar = false;
        let boxEl: Element | null = null; // aktuell umschlossenes Element (Box-Modus)
        let morphEnde = 0; // bis wann der Box-Morph läuft (dann keine Verformung)
        const BOX_PAD = 10; // Luft rund um das Element

        // Auswahl der Elemente, die der Cursor als Box umschliesst: kleine
        // interaktive Elemente. Serienkarten (.serien-link) sind ausgenommen —
        // dort wirkt der Bild-Invert, kein grosser Kasten um die ganze Karte.
        // .lightbox-zone (die grossen Blätter-Flächen im Vollbild) sind bewusst
        // ausgenommen — sonst würde der Cursor zu einem riesigen Kasten um die halbe
        // Bildschirmfläche. Im Vollbild bleibt so der normale kleine Kreis wie sonst.
        const BOX_SELEKTOR =
          'a:not(.serien-link):not(.lightbox-flaeche):not(.lightbox-zone), button, [role="button"], input, label, summary';
        const INTERAKTIV_SELEKTOR =
          'a:not(.lightbox-zone), button, [role="button"], input, label, summary';

        const platziere = () => {
          cursor.style.transform = `translate3d(${istX}px, ${istY}px, 0)`;
        };

        const verstecke = () => {
          sichtbar = false;
          cursor.classList.remove('cursor--sichtbar');
        };

        // Ziel = Mitte des Elements; Punkt auf dessen Grösse/Radius bringen.
        // Rückgabe false, wenn das Element nicht (mehr) dargestellt wird — dann
        // liefert getBoundingClientRect() lauter Nullen, und die Box dürfte diese
        // Nullposition NICHT übernehmen (der Cursor liefe sonst in die linke obere
        // Ecke). Genau das passierte nach dem Entsperren: der Cursor umschloss das
        // Eingabefeld des Tors, und das Tor wird danach auf display:none gesetzt.
        const zielAufBox = () => {
          if (!boxEl) return true;
          const r = boxEl.getBoundingClientRect();
          if (r.width === 0 && r.height === 0) return false;
          const w = r.width + BOX_PAD * 2;
          const h = r.height + BOX_PAD * 2;
          punkt.style.width = `${w}px`;
          punkt.style.height = `${h}px`;
          punkt.style.borderRadius = `${Math.min(w, h) / 2}px`;
          zielX = r.left + r.width / 2;
          zielY = r.top + r.height / 2;
          return true;
        };

        // Box lösen: Punkt zurück auf den Kreis (Werte kommen wieder aus dem CSS;
        // backdrop-filter bleibt dauerhaft am Punkt).
        const loeseBox = () => {
          punkt.style.width = '';
          punkt.style.height = '';
          punkt.style.borderRadius = '';
        };

        // Box aufgeben und zurück in den Freimodus (Ziel = Zeigerposition).
        const boxAufgeben = () => {
          boxEl = null;
          loeseBox();
          cursor.classList.remove('cursor--box');
          morphEnde = performance.now() + 300;
          zielX = mausX;
          zielY = mausY;
        };

        // Ziel-/Modusbestimmung anhand des Elements unter dem Zeiger. Wird sowohl
        // bei Zeigerbewegung als auch beim Scrollen aufgerufen (letzteres mit dem
        // Element, das gerade unter der zuletzt bekannten Zeigerposition liegt) —
        // so bleibt die Box dort, wo die Maus ist, statt beim Blättern mit dem
        // wegscrollenden Element mitzuwandern.
        const aktualisiere = (ziel: Element | null) => {
          // Über einem Foto: kein Box-Modus (der Cursor legt sich nicht um das
          // ganze Bild) — es bleibt der normale, lokal invertierende Kreis unter
          // dem Zeiger. Das Bild selbst wird nicht mehr komplett invertiert.
          const ueberBild = !!(ziel && ziel.closest('img, picture'));
          const boxZiel = ueberBild ? null : (ziel?.closest(BOX_SELEKTOR) ?? null);

          // Box-Modus: der Cursor schwappt in die Umrandung des Elements.
          cursor.classList.toggle('cursor--box', !!boxZiel);
          // Fallback-Vergrösserung nur für interaktive Elemente ohne Box/Bild.
          cursor.classList.toggle(
            'cursor--aktiv',
            !ueberBild && !boxZiel && !!(ziel && ziel.closest(INTERAKTIV_SELEKTOR)),
          );

          if (boxZiel !== boxEl) {
            boxEl = boxZiel;
            // Beim Wechsel läuft der Grössen-Morph (width/height, CSS-Transition).
            // Solange keine elastische Verformung anwenden — sonst überlagern sich
            // Schrumpfen/Wachsen und Dehnung zu einer „zappeligen" Bewegung.
            morphEnde = performance.now() + 300;
            if (boxEl) {
              if (!zielAufBox()) boxAufgeben();
            } else loeseBox();
          }
          if (!boxEl) {
            zielX = mausX;
            zielY = mausY;
          }

          if (reduziert.matches) {
            if (boxEl && !zielAufBox()) boxAufgeben();
            istX = zielX;
            istY = zielY;
            platziere();
          }
        };

        window.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          mausX = e.clientX;
          mausY = e.clientY;
          if (!sichtbar) {
            sichtbar = true;
            istX = mausX;
            istY = mausY;
            cursor.classList.add('cursor--sichtbar');
          }
          aktualisiere(e.target instanceof Element ? e.target : null);
        });

        // Beim Scrollen (z. B. Karussell-Blättern) verschiebt sich der Inhalt unter
        // dem ruhenden Zeiger. Neu bestimmen, was jetzt unter der Maus liegt, damit
        // die Box an der Mausposition bleibt und nicht dem Bild hinterherzieht.
        // Capture-Phase, damit auch das Scrollen innerer Container (Karussell-Spur)
        // erfasst wird (scroll-Events steigen nicht auf).
        window.addEventListener(
          'scroll',
          () => {
            if (!sichtbar) return;
            aktualisiere(document.elementFromPoint(mausX, mausY));
          },
          true,
        );

        window.addEventListener('pointerdown', () => cursor.classList.add('cursor--druck'));
        window.addEventListener('pointerup', () => cursor.classList.remove('cursor--druck'));
        document.addEventListener('mouseleave', verstecke);
        window.addEventListener('blur', verstecke);

        // Weicher Nachlauf; bei reduzierter Bewegung folgt der Cursor sofort.
        if (!reduziert.matches) {
          const lerp = (a: number, b: number, n: number) => a + (b - a) * n;
          const nachlauf = 0.15; // kleiner = weicherer, längerer Nachlauf
          // Elastische Verformung im Freimodus: Der Kreis zieht sich bei Bewegung
          // in die Bewegungsrichtung lang wie ein Wasserballon (ein Objekt, kein
          // Schweif) und relaxt im Stillstand zum Kreis. Grundlage ist der Rückstand
          // zum echten Zeiger (mausX/Y − istX/Y): schnell = grosser Rückstand =
          // starke Dehnung. Ein leichter Versatz nach vorne verankert die „Spitze"
          // beim Zeiger, sodass sich der Schwanz nach hinten dehnt.
          const DEHN_REF = 90; // Rückstand (px) für nahezu maximale Dehnung
          const DEHN_MAX = 1.1; // maximale Zusatz-Längung (scaleX bis 1 + 1.1)
          const QUETSCH = 0.4; // seitliche Stauchung (Volumen-Anmutung)
          const VORNE = 0.32; // Versatz der Spitze Richtung Zeiger
          const DRUCK = 0.7; // Verkleinerung beim Klicken (wie --cursor-skala-druck)
          const schritt = () => {
            // Box beim Scrollen an das Element gebunden halten; verschwindet das
            // Element (aus dem DOM entfernt ODER ausgeblendet, z. B. das Tor nach
            // dem Entsperren), zurück in den Freimodus an die Zeigerposition.
            if (boxEl && (!boxEl.isConnected || !zielAufBox())) boxAufgeben();
            istX = lerp(istX, zielX, nachlauf);
            istY = lerp(istY, zielY, nachlauf);
            platziere();

            // Verformung nur im Freimodus (im Box-Modus bestimmt CSS die Form) und
            // erst, wenn der Box-Morph fertig ist — so snappt die Box sauber weg,
            // ohne dass sich Schrumpfen und Dehnung überlagern.
            if (!boxEl) {
              const dx = mausX - istX;
              const dy = mausY - istY;
              const dist = Math.hypot(dx, dy);
              const druck = cursor.classList.contains('cursor--druck') ? DRUCK : 1;
              if (performance.now() < morphEnde) {
                // Während des Rück-Morphs: sauberer Kreis, keine Verformung.
                punkt.style.transform = `translate(-50%, -50%) scale(${druck})`;
              } else if (dist > 0.6) {
                const s = Math.min(dist / DEHN_REF, 1) * DEHN_MAX;
                const winkel = (Math.atan2(dy, dx) * 180) / Math.PI;
                const sx = 1 + s;
                const sy = 1 - Math.min(s, 1) * QUETSCH;
                const vx = (dx / dist) * dist * VORNE;
                const vy = (dy / dist) * dist * VORNE;
                punkt.style.transform =
                  `translate(-50%, -50%) translate(${vx}px, ${vy}px) ` +
                  `rotate(${winkel}deg) scale(${sx * druck}, ${sy * druck})`;
              } else {
                punkt.style.transform = `translate(-50%, -50%) scale(${druck})`;
              }
            } else {
              // Box-Modus: Inline-Transform entfernen, damit die CSS-Form greift.
              punkt.style.transform = '';
            }
            requestAnimationFrame(schritt);
          };
          requestAnimationFrame(schritt);
        }
      }
    </script>

    <script>
      // Invertierender Touch-Kreis — für Touch-Geräte (kein Cursor dort). Ein
      // einzelner transparenter Kreis mit backdrop-filter: invert(1) folgt der
      // Berührung mit etwas Verzögerung (Nachlauf) und verschwindet beim Loslassen.
      // Kein Schweif, keine Maske. Passive Listener — Scrollen bleibt frei.
      const touchGeraet =
        window.matchMedia('(pointer: coarse)').matches ||
        'ontouchstart' in window ||
        navigator.maxTouchPoints > 0;
      const spurReduziert = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (touchGeraet) {
        const kreis = document.createElement('div');
        kreis.className = 'touch-kreis';
        kreis.setAttribute('aria-hidden', 'true');
        // Düster: invert(1); Farbseite: grayscale(1) invert(1) (Schwarz-Weiss-Invert,
        // auch über Weiss/Schwarz sichtbar). Explizit gesetzt (beide Präfixe) —
        // nicht vom CSS-Minifier verändert.
        const kreisFilter =
          document.documentElement.dataset.modus === 'farbe'
            ? 'grayscale(1) invert(1)'
            : 'invert(1)';
        kreis.style.setProperty('backdrop-filter', kreisFilter);
        kreis.style.setProperty('-webkit-backdrop-filter', kreisFilter);
        document.body.appendChild(kreis);

        let zielX = 0;
        let zielY = 0;
        let istX = 0;
        let istY = 0;
        let sichtbar = false;

        const setze = () => {
          kreis.style.transform = `translate3d(${istX}px, ${istY}px, 0)`;
        };

        const beruehrung = (e: TouchEvent) => {
          const t = e.touches[0];
          if (!t) return;
          zielX = t.clientX;
          zielY = t.clientY;
          if (!sichtbar) {
            // Am Berührungspunkt erscheinen (kein Hereinfliegen von 0,0).
            sichtbar = true;
            istX = zielX;
            istY = zielY;
            setze();
            kreis.classList.add('touch-kreis--sichtbar');
          }
          if (spurReduziert.matches) {
            istX = zielX;
            istY = zielY;
            setze();
          }
        };

        const ende = () => {
          sichtbar = false;
          kreis.classList.remove('touch-kreis--sichtbar');
        };

        window.addEventListener('touchstart', beruehrung, { passive: true });
        window.addEventListener('touchmove', beruehrung, { passive: true });
        window.addEventListener('touchend', ende, { passive: true });
        window.addEventListener('touchcancel', ende, { passive: true });

        // Nachlauf + elastische Verformung wie beim Desktop-Cursor: der Kreis zieht
        // sich bei Bewegung in die Richtung lang wie ein Wasserballon (ein Objekt,
        // kein Schweif) und relaxt im Stillstand zum Kreis. Grundlage ist der
        // Rückstand zur Berührung (zielX/Y − istX/Y).
        if (!spurReduziert.matches) {
          const lerp = (a: number, b: number, n: number) => a + (b - a) * n;
          const nachlauf = 0.18;
          const DEHN_REF = 90; // Rückstand (px) für nahezu maximale Dehnung
          const DEHN_MAX = 1.1; // maximale Zusatz-Längung
          const QUETSCH = 0.4; // seitliche Stauchung (Volumen-Anmutung)
          const VORNE = 0.32; // Versatz der Spitze Richtung Berührung
          const schritt = () => {
            istX = lerp(istX, zielX, nachlauf);
            istY = lerp(istY, zielY, nachlauf);
            const dx = zielX - istX;
            const dy = zielY - istY;
            const dist = Math.hypot(dx, dy);
            if (dist > 0.6) {
              const s = Math.min(dist / DEHN_REF, 1) * DEHN_MAX;
              const winkel = (Math.atan2(dy, dx) * 180) / Math.PI;
              const sx = 1 + s;
              const sy = 1 - Math.min(s, 1) * QUETSCH;
              const vx = dx * VORNE;
              const vy = dy * VORNE;
              kreis.style.transform =
                `translate3d(${istX + vx}px, ${istY + vy}px, 0) ` +
                `rotate(${winkel}deg) scale(${sx}, ${sy})`;
            } else {
              setze();
            }
            requestAnimationFrame(schritt);
          };
          requestAnimationFrame(schritt);
        }
      }
    </script>
  </body>
</html>
