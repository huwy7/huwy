---
import Basis from '../../layouts/Basis.astro';
import Galerie from '../../components/Galerie.astro';
import { ladeSerien, serieUrl } from '../../lib/serien';

// Portfolio, Farbmodus. Aufbau identisch zur düsteren Startseite — sie zeigt die
// oberste Serie und verweist kanonisch auf deren eigene Adresse.
const serien = await ladeSerien('farbe');
const erste = serien[0];
---

{/* Gleicher Tab-Titel wie die düstere Startseite — Entscheidung des Betreibers:
    die Farbseite ist kein eigener Bereich, sondern dieselbe Seite in einem
    anderen Modus. Die unsichtbare Überschrift bleibt unterscheidbar. */}
<Basis
  titel="nicolas huwyler - portfolio"
  modus="farbe"
  vollhoehe
  aktiv={erste?.slug}
  kanonisch={erste ? serieUrl('farbe', erste.slug) : undefined}
>
  <h1 class="visuell-versteckt">nicolas huwyler - portfolio — color</h1>
  <Galerie serien={serien} aktiv={erste?.slug ?? ''} />
</Basis>
