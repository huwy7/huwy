---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Galerie from '../../components/Galerie.astro';
import { ladeAufnahmedaten } from '../../lib/aufnahmedaten';

// Farbmodus — Portfolio (Startseite der farbigen Seite). Kein Untermenü mehr:
// jede Serie liegt als inline-Karussell direkt auf der Seite, gestapelt.
// Flaches Bild-Modell: Farbserien (Metadaten) sortiert, Bilder je Serie aus der
// farbbilder-Sammlung gefiltert/sortiert. Leere Serien fallen weg.
const serienMeta = (await getCollection('farbserien')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge,
);
const alleBilder = await getCollection('farbbilder');
// Aufnahmedaten (Blende/Zeit/ISO/Brennweite) zur Bauzeit aus den Bilddateien, für
// den Polaroid-Streifen unter dem Foto — identisch zur düsteren Startseite.
const daten = ladeAufnahmedaten('farbbilder');
const serien = serienMeta
  .map((serie) => ({
    serie,
    bilder: alleBilder
      .filter((b) => b.data.serie === serie.id)
      .sort((a, b) => a.data.reihenfolge - b.data.reihenfolge)
      .map((b) => ({ bild: b.data.bild, daten: daten.get(b.id) })),
  }))
  .filter((s) => s.bilder.length > 0);
---

{/* Gleicher Tab-Titel wie die Startseite — Entscheidung des Betreibers: die
    Farbseite ist kein eigener Bereich, sondern dieselbe Seite in einem anderen
    Modus. Die unsichtbare Überschrift darunter bleibt unterscheidbar, damit
    Screenreader und Suchmaschinen die beiden Startseiten auseinanderhalten. */}
<Basis titel="nicolas huwyler - portfolio" modus="farbe" vollhoehe>
  <h1 class="visuell-versteckt">nicolas huwyler - portfolio — color</h1>

  <Galerie serien={serien} modus="farbe" />
</Basis>

