---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Basis from '../layouts/Basis.astro';
import Bild from '../components/Bild.astro';

// Sortierung nach reihenfolge (Spezifikation 7), nicht nach Jahr/alphabetisch.
const serien = (await getCollection('serien')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge,
);

// Das Titelbild (= erstes Bild der Serie) jeder Serie als AVIF im Hintergrund
// vorladen, damit die Serienseite beim Anklicken sofort ihr erstes Bild zeigt.
// Breite 1280 und Qualität 65 sind identisch zur Serienseite (Bild.astro, widths +
// QUALITAET.avif), damit die vorgeladene URL exakt einem srcset-Eintrag entspricht.
const bildVorladen = await Promise.all(
  serien.map(async (serie) => {
    const avif = await getImage({
      src: serie.data.titelbild,
      widths: [1280],
      format: 'avif',
      quality: 65,
    });
    return avif.src;
  }),
);
---

<!-- Startseite (Spezifikation 6.1). Erstes sichtbares Element unter dem Header
     ist ein Bild; die h1 trägt den Namen nur für Screenreader. -->
<Basis titel="TODO_NAME" bildVorladen={bildVorladen}>
  <h1 class="visuell-versteckt">TODO_NAME</h1>

  <ul class="serien-liste">
    {
      serien.map((serie, i) => (
        <li class="serien-eintrag">
          <a class="serien-link" href={`/serien/${serie.id}`}>
            <Bild
              class="vorschau-bild"
              src={serie.data.titelbild}
              alt=""
              widths={[640, 960, 1280, 1600, 2000]}
              sizes="(max-width: 768px) 100vw, 1088px"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
            <span class="serien-meta">
              <span class="serien-titel">{serie.data.titel}</span>
              <span class="serien-jahr">{serie.data.jahr}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Basis>

<style>
  .serien-liste {
    list-style: none;
  }

  /* Abstand zwischen Serien: 15vh (Spezifikation 6.1). */
  .serien-eintrag + .serien-eintrag {
    margin-block-start: var(--rhythmus-serie);
  }

  /* Ganze Karte ist ein Navigationslink — nicht unterstrichen, der Fokusring
     macht ihn sichtbar. */
  .serien-link {
    display: block;
    text-decoration: none;
    color: var(--farbe-text);
  }

  /* Vorschaubild (.vorschau-bild) steht global — das <img> kommt aus der
     Bild-Komponente. Kein Zuschnitt: das Titelbild behält sein eigenes
     Seitenverhältnis (Höhe gedeckelt, siehe global.css). */

  /* 32px zwischen Bild und Beschriftung (Spezifikation 6.1). */
  .serien-meta {
    display: flex;
    flex-direction: column;
    gap: var(--abstand-8);
    margin-block-start: var(--abstand-32);
    font-family: var(--schrift-mono);
    font-size: var(--groesse-14);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-4);
    font-variant-ligatures: none;
  }

  .serien-jahr {
    color: var(--farbe-text-leise);
  }
</style>
