---
import Basis from '../layouts/Basis.astro';
import Galerie from '../components/Galerie.astro';
import { ladeSerien, serieUrl } from '../lib/serien';

// Portfolio, düsterer Modus. Zeigt die oberste Serie (der Betreiber steuert die
// Reihenfolge über `reihenfolge`, 1 = zuoberst) — inhaltlich dasselbe wie
// /serie/<erste>. Darum verweist die Kanonik dorthin: die Serie hat ihre eigene
// Adresse, diese hier ist nur der Einstieg. Ändert sich die Reihenfolge, ändert
// sich der Einstieg, aber keine Serien-Adresse.
const serien = await ladeSerien('duester');
const erste = serien[0];
---

<Basis
  titel="nicolas huwyler - portfolio"
  vollhoehe
  aktiv={erste?.slug}
  kanonisch={erste ? serieUrl('duester', erste.slug) : undefined}
>
  <h1 class="visuell-versteckt">nicolas huwyler - portfolio</h1>
  <Galerie serien={serien} aktiv={erste?.slug ?? ''} />
</Basis>
