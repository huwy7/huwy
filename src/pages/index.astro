---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Serie from '../components/Serie.astro';

// Startseite (düsterer Standard-Modus). Kein Untermenü mehr: jede Serie liegt als
// inline-Karussell direkt auf der Seite, gestapelt (neueste oben — der Betreiber
// steuert die Reihenfolge über `reihenfolge`, 1 = zuoberst). Blättern und Vollbild
// stecken in Serie.astro (reines CSS). Siehe docs/farbmodus-ideensammlung.md B2.
const serien = (await getCollection('serien')).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge,
);
---

<Basis titel="TODO_NAME">
  <h1 class="visuell-versteckt">TODO_NAME</h1>

  <div class="serien-liste">
    {serien.map((serie) => <Serie serie={serie} />)}
  </div>
</Basis>

<style>
  .serien-liste {
    display: flex;
    flex-direction: column;
  }

  /* Abstand zwischen Serien (Spezifikation 6.1). */
  .serien-liste :global(.serie) + :global(.serie) {
    margin-block-start: var(--rhythmus-serie);
  }
</style>
