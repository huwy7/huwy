---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';
import Bild from '../../components/Bild.astro';

export async function getStaticPaths() {
  const serien = (await getCollection('serien')).sort(
    (a, b) => a.data.reihenfolge - b.data.reihenfolge,
  );
  return serien.map((serie, i) => ({
    params: { slug: serie.id },
    // Zyklisch: die letzte Serie zeigt auf die erste (Spezifikation 6.2).
    props: { serie, naechste: serien[(i + 1) % serien.length] },
  }));
}

const { serie, naechste } = Astro.props;
const { Content } = await render(serie);

// meta description aus dem Einleitungstext (Spezifikation 10).
const beschreibung = (serie.body ?? '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160);

// Open-Graph-Bild: Titelbild auf 1200×630 zugeschnitten (Spezifikation 10).
const og = await getImage({
  src: serie.data.titelbild,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 80,
});

// Erstes Bild der nächsten Serie im Hintergrund vorladen (rel="prefetch"), damit
// der „Nächste Serie"-Sprung sofort ein Bild zeigt. Parameter identisch zur
// Bilddarstellung (Breite 1280, AVIF q65) — echter Cache-Treffer.
const naechstesBild = naechste.data.bilder[0]?.datei;
const bildVorladen = naechstesBild
  ? [(await getImage({ src: naechstesBild, widths: [1280], format: 'avif', quality: 65 })).src]
  : [];
---

<!-- Serienseite (Spezifikation 6.2). Header-Abstand 64px, Bildnormierung 5.1. -->
<Basis
  titel={`${serie.data.titel} — TODO_NAME`}
  beschreibung={beschreibung}
  ogBild={og.src}
  bildVorladen={bildVorladen}
>
  <article class="serie">
    <h1 class="serie-titel">{serie.data.titel}</h1>
    <p class="serie-jahr">{serie.data.jahr}</p>

    <div class="serie-einleitung">
      <Content />
    </div>

    <div class="serie-bilder">
      {
        serie.data.bilder.map((bild) => (
          <Bild
            class="serie-bild"
            src={bild.datei}
            alt={bild.alt}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="100vw"
            loading="lazy"
          />
        ))
      }
    </div>

    <a class="naechste-serie" href={`/serien/${naechste.id}`}>
      Nächste Serie: {naechste.data.titel} →
    </a>
  </article>
</Basis>

<style>
  /* Serientitel: mono 22px (Mobile 19px), Zeilenhöhe 1.3 (Spezifikation 3.4). */
  .serie-titel {
    font-family: var(--schrift-mono);
    font-size: var(--groesse-22);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-3);
    font-variant-ligatures: none;
  }

  /* 16px zwischen Titel und Jahr (Spezifikation 6.2). */
  .serie-jahr {
    margin-block-start: var(--abstand-16);
    font-family: var(--schrift-mono);
    font-size: var(--groesse-14);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-4);
    font-variant-ligatures: none;
    color: var(--farbe-text-leise);
  }

  /* 32px zwischen Jahr und Einleitung; Fliesstext linksbündig, max. 60ch. */
  .serie-einleitung {
    margin-block-start: var(--abstand-32);
    max-width: var(--textbreite);
  }

  /* 12vh zwischen Einleitung und Bildern; 12vh zwischen den Bildern selbst
     (Spezifikation 6.2). Spaltenlayout mit gap, damit der <picture>-Wrapper der
     Bild-Komponente den Abstand nicht bricht. Zentriert die höhennormierten
     Bilder (Höhennormierung selbst steht global, .serie-bild). */
  .serie-bilder {
    margin-block-start: var(--rhythmus-block);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--rhythmus-block);
  }

  /* 12vh vor „Nächste Serie". */
  .naechste-serie {
    display: block;
    margin-block-start: var(--rhythmus-block);
    font-family: var(--schrift-mono);
    font-size: var(--groesse-14);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-4);
    font-variant-ligatures: none;
    text-decoration: none;
    color: var(--farbe-text);
  }

  /* Mobile: 48px zwischen Bildern (volle Breite regelt .serie-bild global). */
  @media (max-width: 768px) {
    .serie-bilder {
      gap: var(--abstand-48);
    }
  }
</style>
