---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';

export async function getStaticPaths() {
  const serien = (await getCollection('serien')).sort(
    (a, b) => a.data.reihenfolge - b.data.reihenfolge,
  );
  return serien.map((serie, i) => ({
    params: { slug: serie.id },
    // Zyklisch: die letzte Serie zeigt auf die erste (Spezifikation 6.2).
    props: { serie, naechste: serien[(i + 1) % serien.length] },
  }));
}

const { serie, naechste } = Astro.props;
const { Content } = await render(serie);
---

<!-- Serienseite (Spezifikation 6.2). Header-Abstand 64px, Bildnormierung 5.1. -->
<Basis titel={`${serie.data.titel} — TODO_NAME`} abstandOben="var(--abstand-64)">
  <article class="serie">
    <h1 class="serie-titel">{serie.data.titel}</h1>
    <p class="serie-jahr">{serie.data.jahr}</p>

    <div class="serie-einleitung">
      <Content />
    </div>

    <div class="serie-bilder">
      {
        serie.data.bilder.map((bild) => (
          <Image
            class="serie-bild"
            src={bild.datei}
            alt={bild.alt}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="100vw"
            loading="lazy"
            decoding="async"
          />
        ))
      }
    </div>

    <a class="naechste-serie" href={`/serien/${naechste.id}`}>
      Nächste Serie: {naechste.data.titel} →
    </a>
  </article>
</Basis>

<style>
  /* Serientitel: mono 22px (Mobile 19px), Zeilenhöhe 1.3 (Spezifikation 3.4). */
  .serie-titel {
    font-family: var(--schrift-mono);
    font-size: var(--groesse-22);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-3);
    font-variant-ligatures: none;
  }

  /* 16px zwischen Titel und Jahr (Spezifikation 6.2). */
  .serie-jahr {
    margin-block-start: var(--abstand-16);
    font-family: var(--schrift-mono);
    font-size: var(--groesse-14);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-4);
    font-variant-ligatures: none;
    color: var(--farbe-text-leise);
  }

  /* 32px zwischen Jahr und Einleitung; Fliesstext linksbündig, max. 60ch. */
  .serie-einleitung {
    margin-block-start: var(--abstand-32);
    max-width: var(--textbreite);
  }

  /* 12vh zwischen Einleitung und Bildern (Spezifikation 6.2). */
  .serie-bilder {
    margin-block-start: var(--rhythmus-block);
  }

  /* Höhennormierung (Spezifikation 5.1): jedes Bild gleich hoch. */
  .serie-bild {
    display: block;
    max-height: var(--bild-max-hoehe);
    width: auto;
    max-width: 100%;
    margin-inline: auto;
  }

  /* 12vh zwischen den Bildern (Spezifikation 6.2). */
  .serie-bild + .serie-bild {
    margin-block-start: var(--rhythmus-block);
  }

  /* 12vh vor „Nächste Serie". */
  .naechste-serie {
    display: block;
    margin-block-start: var(--rhythmus-block);
    font-family: var(--schrift-mono);
    font-size: var(--groesse-14);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-4);
    font-variant-ligatures: none;
    text-decoration: none;
    color: var(--farbe-text);
  }

  /* Mobile: volle Breite statt Höhennormierung, 48px zwischen Bildern. */
  @media (max-width: 768px) {
    .serie-bild {
      max-height: none;
      width: 100%;
    }
    .serie-bild + .serie-bild {
      margin-block-start: var(--abstand-48);
    }
  }
</style>
