---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Basis from '../../layouts/Basis.astro';
import Bild from '../../components/Bild.astro';

export async function getStaticPaths() {
  const serien = (await getCollection('serien')).sort(
    (a, b) => a.data.reihenfolge - b.data.reihenfolge,
  );
  return serien.map((serie, i) => ({
    params: { slug: serie.id },
    // Zyklisch: die letzte Serie zeigt auf die erste (Spezifikation 6.2).
    props: { serie, naechste: serien[(i + 1) % serien.length] },
  }));
}

const { serie, naechste } = Astro.props;
const { Content } = await render(serie);

// meta description aus dem Einleitungstext (Spezifikation 10).
const beschreibung = (serie.body ?? '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 160);

// Open-Graph-Bild: Titelbild auf 1200×630 zugeschnitten (Spezifikation 10).
const og = await getImage({
  src: serie.data.titelbild,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: 80,
});

// Titelbild der nächsten Serie (= deren erstes Bild) im Hintergrund vorladen
// (rel="prefetch"), damit der „Nächste Serie"-Sprung sofort ein Bild zeigt.
// Parameter identisch zur Bilddarstellung (Breite 1280, AVIF q65) — Cache-Treffer.
const bildVorladen = [
  (await getImage({ src: naechste.data.titelbild, widths: [1280], format: 'avif', quality: 65 }))
    .src,
];

// Anzeigereihenfolge: Titelbild zuerst, dann die weiteren Bilder.
const alleBilder = [serie.data.titelbild, ...serie.data.bilder];

// Einleitung nur zeigen, wenn Text vorhanden ist (sonst kein leerer Block).
const hatEinleitung = (serie.body ?? '').trim().length > 0;
---

<!-- Serienseite (Spezifikation 6.2). Header-Abstand 64px, Bildnormierung 5.1. -->
<Basis
  titel={`${serie.data.titel} — TODO_NAME`}
  beschreibung={beschreibung}
  ogBild={og.src}
  bildVorladen={bildVorladen}
>
  <article class="serie">
    <h1 class="serie-titel">{serie.data.titel}</h1>
    <p class="serie-jahr">{serie.data.jahr}</p>

    {
      hatEinleitung && (
        <div class="serie-einleitung">
          <Content />
        </div>
      )
    }

    <div class="serie-bilder">
      {
        alleBilder.map((bild, i) => (
          <Fragment>
            {/* Anklickbares Bild öffnet die Vollbild-Ansicht (reines CSS via :target,
                kein JavaScript). Das id am Öffner dient zugleich als Schliess-Ziel,
                damit man beim Schliessen wieder beim Bild landet. */}
            <a
              id={`b-${serie.id}-${i}`}
              href={`#lb-${serie.id}-${i}`}
              class="bild-oeffnen"
              aria-label="Bild als Vollbild öffnen"
            >
              <Bild
                class="serie-bild"
                src={bild}
                alt=""
                widths={[640, 960, 1280, 1600, 2000]}
                sizes="100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </a>

            <div id={`lb-${serie.id}-${i}`} class="lightbox">
              {/* Weisse Fläche rundum: Klick darauf schliesst. */}
              <a href={`#b-${serie.id}-${i}`} class="lightbox-flaeche" aria-label="Schliessen" />
              <Bild
                class="lightbox-bild"
                src={bild}
                alt=""
                widths={[640, 960, 1280, 1600, 2000]}
                sizes="100vw"
                loading="lazy"
              />
              <a href={`#b-${serie.id}-${i}`} class="lightbox-x" aria-label="Schliessen">
                ×
              </a>
            </div>
          </Fragment>
        ))
      }
    </div>

    <a class="naechste-serie" href={`/serien/${naechste.id}`}>
      Nächste Serie: {naechste.data.titel} →
    </a>
  </article>
</Basis>

<style>
  /* Serientitel: mono 22px (Mobile 19px), Zeilenhöhe 1.3 (Spezifikation 3.4). */
  .serie-titel {
    font-family: var(--schrift-mono);
    font-size: var(--groesse-22);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-3);
    font-variant-ligatures: none;
  }

  /* 16px zwischen Titel und Jahr (Spezifikation 6.2). */
  .serie-jahr {
    margin-block-start: var(--abstand-16);
    font-family: var(--schrift-mono);
    font-size: var(--groesse-14);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-4);
    font-variant-ligatures: none;
    color: var(--farbe-text-leise);
  }

  /* 32px zwischen Jahr und Einleitung; Fliesstext linksbündig, max. 60ch. */
  .serie-einleitung {
    margin-block-start: var(--abstand-32);
    max-width: var(--textbreite);
  }

  /* 12vh zwischen Einleitung und Bildern; 12vh zwischen den Bildern selbst
     (Spezifikation 6.2). Spaltenlayout mit gap, damit der <picture>-Wrapper der
     Bild-Komponente den Abstand nicht bricht. Zentriert die höhennormierten
     Bilder (Höhennormierung selbst steht global, .serie-bild). */
  .serie-bilder {
    margin-block-start: var(--rhythmus-block);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--rhythmus-block);
  }

  /* Öffner umschliesst das Bild eng (schrumpft auf dessen Grösse). */
  .bild-oeffnen {
    display: block;
    text-decoration: none;
    line-height: 0;
  }

  /* --- Vollbild-Ansicht (Lightbox, reines CSS über :target) ---
     Weisse Fläche über der ganzen Seite, Bild zentriert — maximale Konzentration
     auf das Bild. Standardmässig ausgeblendet, sichtbar nur als :target. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-lightbox);
    display: none;
    background-color: var(--farbe-rahmen); /* weiss */
  }

  .lightbox:target {
    display: block;
  }

  /* Ganzflächiger Schliess-Bereich (die weisse Fläche neben dem Bild). */
  .lightbox-flaeche {
    position: absolute;
    inset: 0;
  }

  /* In der Vollbild-Ansicht den nativen Zeiger zeigen: der invertierende Ball
     (mix-blend-mode) wäre auf Weiss unsichtbar. zoom-out signalisiert „klicken
     zum Schliessen"; über dem Kreuz ein Pointer, über dem Bild neutral. */
  .lightbox,
  .lightbox-flaeche {
    cursor: zoom-out;
  }
  .lightbox-x {
    cursor: pointer;
  }

  /* Das Bild im Vollbild (.lightbox-bild) steht global — das <img> kommt aus der
     Bild-Komponente und trägt deren Scope, nicht den dieser Seite. */

  /* Schliessen-Kreuz oben rechts. */
  .lightbox-x {
    position: absolute;
    top: var(--abstand-24);
    right: var(--abstand-24);
    z-index: 2;
    font-family: var(--schrift-mono);
    font-size: var(--groesse-22);
    line-height: 1;
    color: var(--farbe-hintergrund); /* dunkel auf Weiss */
    text-decoration: none;
  }

  /* 12vh vor „Nächste Serie". inline-block, damit der Cursor-Kasten (Box-Modus)
     eng um den Text schwappt statt über die volle Breite. */
  .naechste-serie {
    display: inline-block;
    margin-block-start: var(--rhythmus-block);
    font-family: var(--schrift-mono);
    font-size: var(--groesse-14);
    font-weight: var(--gewicht-400);
    line-height: var(--zeilenhoehe-1-4);
    font-variant-ligatures: none;
    text-decoration: none;
    color: var(--farbe-text);
  }

  /* Mobile: 48px zwischen Bildern (volle Breite regelt .serie-bild global). */
  @media (max-width: 768px) {
    .serie-bilder {
      gap: var(--abstand-48);
    }
  }
</style>
