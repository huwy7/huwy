---
import { getEntry } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import UeberInhalt from '../components/UeberInhalt.astro';

// About me (düster). Bilder mit optionalem Text je Bild (seiten/ueber-mich),
// abwechselnd links/rechts. Der Spotify-API-Platzhalter kommt nur hier dazu.
const eintrag = await getEntry('seiten', 'ueber-mich');
const eintraege = eintrag!.data.bilder.map((b) => ({ bild: b.bild, text: b.text }));
---

<Basis titel="About me — nicolas huwyler - portfolio">
  <h1 class="seiten-titel">About me</h1>
  <UeberInhalt eintraege={eintraege} spotify />
</Basis>
